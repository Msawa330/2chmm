.com/www.movient.net/wp-content/uploads/2026/11/202611080914211924577485edupeUr.jpeg"}],[{"text":">>1"},{"br":1},{"text":"\nゾロ"},{"br":1},{"text":">>9"},{"br":1},{"text":"\nバカみたいな漫画だよ"}],[{"text":"尾田栄一郎に怒られるぞ"},{"br":1},{"text":"スレッドURL:"},{"text":"https://tomcat.2ch.sc/test/read.cgi/livegalileo/1793407234/"}],[{"text":"こういうのでいいんだよ尾田くん"}],[{"text":"この方が見やすい"}],[{"text":"手抜きは良くないな"}],[{"text":"面白すぎる"}],[{"text":"読みやす"}],[{"img":"https://i0.wp.com/www.movient.net/wp-content/uploads/2026/11/202611080914211325144762pKg2hqI.png"}],[{"text":">>9"},{"br":1},{"text":"\nサムネの色の濃さが違いすぎて草"}],[{"text":"尾田くん…見直したぞ"}],[{"text":"ギャグもちゃんとおもろいやん"}],[{"text":"漫画は引き算"}],[{"text":"十分描き込まれてる"}],[{"text":"編集におさえつけられて描きたい物を描けなかった可哀想な時代やね"}],[{"text":">>17"},{"br":1},{"text":"\n編集有能"}],[{"text":"ギャグもおもろいな"}],[{"text":"もう目玉飛び出てるやん"}],[{"text":"最初から密度上げるとサムライ8になるだろ馬鹿か？"}],[{"text":"この頃のゾロ好き"}],[{"text":"この頃みんなかっこいいねちょっと大人な感じで"}],[{"text":"怒ると歯ギザギザになるやつ懐かしいな"}],[{"text":"あまりにも見やすい"}],[{"text":"最後にギャグ調になる漫画無かったから描きたい言うてるらしいけど逆張り好きなだけなんやろな"}],[{"text":"かわいそうなウソップ海賊団"},{"br":1},{"img":"https://i1.wp.com/www.movient.net/wp-content/uploads/2026/11/20261108091421923127022J4S7VIU.jpeg"}],[{"text":">>29"},{"br":1},{"text":"\nくそわろ"}],[{"text":"余白って大事なんやな"},{"br":1},{"text":"\n無駄な情報がない"}],[{"text":"この頃ほんまキャラが生きてるな"},{"br":1},{"text":"\nいまの仲間みんな感情死んでるし"}],[{"text":"なんで君ら頻繁に叩いてんの？"}],[{"text":"これなら子供たちに大人気や☺"}],[{"text":"現在の尾田くんは叩かれるのに"},{"br":1},{"text":"\n過去の尾田くんは神格化されるの草"}],[{"text":"無理やり名作に改変されてた尾田くん可哀想"}],[{"text":"初期は見やすいしギャグも面白いしほんまに同じ作者なのか疑わしくなる"}],[{"img":"https://i1.wp.com/www.movient.net/wp-content/uploads/2026/11/202611080914211827737762GEC345P.jpeg"},{"br":1},{"img":"https://i1.wp.com/www.movient.net/wp-content/uploads/2026/11/2026110809142167113571DhoZtKQ.jpeg"}],[{"text":">>42"},{"br":1},{"text":"\nちょっと説明台詞多すぎかなー"}],[{"text":"和月先生のアシスタントらしいシュッとした線だったのに"},{"br":1},{"text":"\nいつからか日常シーンでも頂上戦争みたいなずいぶん個性的な絵に…"}],[{"text":"読みやす"}],[{"text":"和月組とかいうなんかいろいろアレな集まり"}],[{"text":"これ見たら尾田くんセンスあるんだなって思う