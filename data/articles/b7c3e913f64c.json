ize":18,"bold":true,"text":">>64"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"何度もある"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"あれならすいとんぶち込んだ方がましだろ"}],[{"color":"#111111","size":18,"bold":true,"text":"あれ？アキレスないの？"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"断トツでアキレスが１番美味いだろ"}],[{"color":"#111111","size":18,"bold":true,"text":"初めて食ったちくわぶが物凄く硬くて不味かったんで、未だにちくわぶの必要性が分からない。"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"同じ小麦の塊なら、うどん入れた方が良いわ。"}],[{"color":"#111111","size":18,"bold":true,"text":"ちくわぶ言うからいっぺん買って食べてみたけど二度と買う事はない"}],[{"color":"#1f32ff","size":18,"bold":true,"text":">>82"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"ちゃんと煮込まないと消しゴムだぜ"}],[{"color":"#7c3aed","size":18,"bold":true,"text":"白滝「おい！どういう事だ！」"},{"br":1},{"color":"#7c3aed","size":18,"bold":true,"text":"はんぺん「俺達が…いないだと！？」"}],[{"color":"#111111","size":18,"bold":true,"text":"ちくわぶそのものは味がないからクタクタになるまで煮込めって言うけど"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"食感を楽しむものらしいのにそれでいいのか？って思うし"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"じゃあはんぺんとかがんもどきでよくない？とも思う"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"関西でもはんぺんはギリギリ売ってるけどちくわぶはマジで見たことないな"}],[{"color":"#15803d","size":18,"bold":true,"text":"稚内のおでん屋「おまん」で食ったロールキャベツは中身が挽肉じゃなくて鮭だった、これはこれでありだと思った"}],[{"color":"#b45309","size":18,"bold":true,"text":"地元福岡では練り物の一つに餃子巻き（練り物の中に餃子）があるが他では無いの知って驚愕した思い出"},{"br":1},{"color":"#b45309","size":18,"bold":true,"text":"ウインナー巻きは他でもあるのになぜ？"}],[{"color":"#1f32ff","size":18,"bold":true,"text":">>124"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"それ先週ニュースでやってたな"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"個人店の店主が自己開発したのが人気になってそれが広まったってやつ"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"ご当地もんやね"}],[{"color":"#111111","size":18,"bold":true,"text":"ちくわぶは関東だけでしょう"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"西日本どころか静岡おでんにはもう無い"}],[{"color":"#d62828","size":18,"bold":true,"text":"大根だろと思ったら一位大根だった"}]],"comments":["桜井ハッカー侮辱罪",">大根が好きなんだけど何日置いてたのか知らんけどカチカチになったやつは引っ込めて欲しい\n大根は何日も煮込まれるとカチカチじゃなく逆にふにゃふにゃに溶ける\nちくわぶの食べ頃は短いまさにうどんとかすいとんと同じで煮込み過ぎると伸びた小麦粉の塊でちょうどよく煮込まれたのは腰と言うか弾力もあって美味い","自分だけで食べるならねりものなしで\n大根、卵、こんにゃく、昆布だけでもええわ",">>3\n練り物無しで作るとものごっつ味が残念な事になるのが…","大根は龍が如くを思い出してしまう。"]}