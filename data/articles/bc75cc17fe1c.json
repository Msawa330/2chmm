{"id":"bc75cc17fe1c","publishedAt":1794179959000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/jyoseisama/imgs/a/3/a3456322.png"},{"br":1},{"color":"gray","size":12,"text":"編集元: 今までにあった修羅場を語れ【その19】"}],[{"color":"#dc143c","size":16,"bold":true,"text":"\n 人生初スキー"},{"br":1},{"color":"#dc143c","size":16,"bold":true,"text":"リフトからまともに降りられなくて止めるとこ数しれず"},{"br":1},{"color":"#dc143c","size":16,"bold":true,"text":"滑ったのはいいが、止まれなくて人にぶつかりニアミスすること数回"},{"br":1},{"color":"#dc143c","size":16,"bold":true,"text":"満身創痍"}],[{"size":16,"bold":true,"text":"\n 人にぶつかってるならニアミスじゃない"}],[{"size":16,"bold":true,"text":"\n しかも数回って"},{"br":1},{"size":16,"bold":true,"text":"明らかに悪意がある"},{"br":1},{"size":16,"bold":true,"text":"それで他人が怪我したらどう責任とるの"},{"br":1},{"size":16,"bold":true,"text":"頭足りないの？"}],[{"size":16,"bold":true,"text":"\n 止まれないときは他人に接近する前に自分でこけろってんだカスが"},{"br":1},{"size":16,"bold":true,"text":"不愉快だから二度と書き込まないでね"}],[{"size":16,"bold":true,"color":"mediumblue","text":">>626"},{"br":1},{"size":16,"bold":true,"text":"危なすぎてすごく迷惑な存在"},{"br":1},{"size":16,"bold":true,"text":"下の緩やかな辺りで止まれるなり転ぶなりの練習してから上れよ"},{"br":1},{"size":16,"bold":true,"text":"エッジ引っかかるとウェア破損するし相手に出血物の怪我させるかもしれないのに"},{"br":1},{"size":16,"bold":true,"text":"信じられない思考回路"}],[{"size":16,"bold":true,"text":"\n 悪意はない"},{"br":1},{"size":16,"bold":true,"text":"下手なんだから最初はこうなって当然"},{"br":1},{"size":16,"bold":true,"text":"俺も何人かにぶつかられたが文句はいいっこなしだ"},{"br":1},{"size":16,"bold":true,"text":"コケて止まるというのも試したが、コントロールを失うので絶対にやったらだめだと叱られた"}],[{"size":16,"bold":true,"color":"mediumblue","text":">>626"},{"br":1},{"size":16,"bold":true,"text":"止まれないうちはリフトに乗ったらいけないよ"},{"br":1},{"size":16,"bold":true,"text":"最初は殆ど平らに近いような場所で"},{"br":1},{"size":16,"bold":true,"text":"横歩きでえらおっちら登るんだ"},{"br":1},{"size":16,"bold":true,"text":"まずは止まる練習からするんだ"},{"br":1},{"size":16,"bold":true,"text":"スキーの制動は自分の筋力だけが頼りだから"},{"br":1},{"size":16,"bold":true,"text":"ゆっくりした速さから始めて、どの速さまでならピタッと止まれるか自分で知っておくこと"},{"br":1},{"size":16,"bold":true,"text":"早めに減速して自分の限界を超えないようにすること"},{"br":1},{"size":16,"bold":true,"text":"スキー保険には必ず入っておこうね"},{"br":1},{"size":16,"bold":true,"text":"速度が付いた衝突事故は人を頃せる"},{"br":1},{"size":16,"bold":true,"text":"車で人を轢いたのと同じ賠償を求められるからね"},{"br":1},{"size":16,"bold":true,"text":"保険はゲレンデでも入れるものがあるからまだスキー場にいるならお早めに"}],[{"size":16,"bold":true,"text":"\n 悪意はないって善悪が分からないバカって事なんだが。"}],[{"size":16,"bold":true,"color":"mediumblue","text":">>631"},{"br":1},{"size":16,"bold":true,"text":"悪意がなきゃなにやってもいいんかいって話だよ"},{"br":1},{"size":16,"bold":true,"text":"自分の技量以上のところに行こうとは思わないことだ"}],[{"size":16,"bold":true,"text":"\n 初心者コースだけいった"}],[{"size":16,"bold":true,"color":"mediumblue","text":">>635"},{"br":1},{"size":16,"bold":true,"text":"止まれもしないのに、リフトに乗って行くような場所に移動している時点で無謀"},{"br":1},{"size":16,"bold":true,"text":"きちんと基礎をこなしてから上がろう"},{"br":1},{"size":16,"bold":true,"text":"初心者以前ってことだよ"}],[{"size":16,"bold":true,"text":"\n 学校でスキーって習わない物なの？って思って調べたら、あれ雪国限定なんだな"},{"br":1},{"size":16,"bold":true,"text":"でも小学生の初心者でも止まったりリフト降りるぐらいはみんなできたぞ"},{"br":1},{"size":16,"bold":true,"text":"一人じゃできないなら経験者つれてきなよ"}]],"comments":[]}