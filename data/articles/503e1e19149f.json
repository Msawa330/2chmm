{"id":"503e1e19149f","publishedAt":1794201221000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/diet2channel/imgs/0/0/007bb261.png"}],[{"color":"#0000cd","size":16,"bold":true,"text":" 俺はこんなの "}],[{"size":16,"bold":true,"text":" 俺は割りとこうだな "}],[{"size":16,"bold":true,"text":" 少し違うけどだいたい同じだった "}],[{"color":"#0000cd","size":16,"bold":true,"text":" あ "},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/diet2channel/imgs/9/b/9bb6afb3.png"}],[{"color":"mediumblue","size":24,"bold":true,"text":">>4"},{"br":1},{"color":"#FF6600","size":24,"bold":true,"text":" マジでこれだった "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>4"},{"br":1},{"size":16,"bold":true,"text":" 人の左側にあるやつパソコン？テレビ？ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>7"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" ノーパソ "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>8"},{"br":1},{"size":16,"bold":true,"text":" すごい "}],[{"size":16,"bold":true,"text":" 🤣←ワイ "}],[{"size":16,"bold":true,"text":" うつ伏せだろ？ "}],[{"size":16,"bold":true,"text":" 寝て見ると顔がヒラメみたいになるぞ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>11"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" どゆこと？ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" うつ伏せだと苦しい "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" お腹が圧迫される "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>12"},{"br":1},{"size":16,"bold":true,"text":" 痩せようぜ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>17"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" お腹もだけど顎とか痛くなるだろ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 横向きが一番負荷かからなくていい "}],[{"size":16,"bold":true,"text":" こんな感じ "},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/diet2channel/imgs/3/b/3b332472.png"}],[{"color":"mediumblue","size":16,"bold":true,"text":">>14"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" これ座椅子？ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" いろんなスタイル試したけど結局俺は横向きに寝転がるスタイルに落ち着いた "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>16"},{"br":1},{"size":16,"bold":true,"text":" いいや、ただの標準的なオフィスチェア。横になるのは片方の耳の音が聞こえ辛くなるから好きじゃないなぁ "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>14"},{"br":1},{"size":16,"bold":true,"text":" ワイもこれ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" ノートパソコンは必ず左側や手前にイヤホンジャックがついてるモデルを選ぶ事が重要 "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" あとはACアダプタの差込口が右面に無い事 "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 右面以外にマウス用のUSBコネクタついてる事 "}],[{"color":"#0000cd","size":16,"bold":true,"text":" アニメにはタブレットとかいうやつ居るけどタブレットじゃダメなんだよなあ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" スタンド使うと角度つくから "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" ノーパソならキーボードで支えれば完全に水平にできる "}],[{"color":"#0000cd","size":16,"bold":true,"text":" クッション使えば大丈夫だろ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" イヤホンの種類にもよりそうだが "}],[{"color":"#dc143c","size":24,"bold":true,"text":" わろた "},{"br":1},{"bold":true,"color":"rgb(255, 51, 102)","text":"▼アクセスの多い関連記事"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/63559780.html","color":"rgb(0, 102, 204)","text":"痩せているのにお腹だけ出ている人って何なんだ？ｗｗ"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/63527239.html","color":"rgb(0, 102, 204)","text":"【健康】姿勢を正して変わったことってある？"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/63493410.html","color":"rgb(0, 102, 204)","text":"【画像】姿勢が悪い気がするけど、どこを直せばいい？"},{"br":1},{"color":"gray","text":"引用元:"},{"color":"gray","text":"https://hebi.5ch.net/test/read.cgi/news4vip/1615639196/"},{"br":1},{"text":"<url>"},{"text":"<title>"}]],"comments":[]}