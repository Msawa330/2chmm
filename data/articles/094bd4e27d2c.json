{"id":"094bd4e27d2c","publishedAt":1795344641000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/danseisama/imgs/c/3/c359f755.jpg"},{"br":1},{"color":"rgb(128, 128, 128)","size":12,"text":"結婚生活に疲れた人・・・93人目"}],[{"color":"rgb(42, 18, 138)","size":16,"bold":true,"text":"毎日毎日毎日些細な言葉尻とらえてからの小競り合い本当に疲れた。"},{"br":1},{"color":"rgb(42, 18, 138)","size":16,"bold":true,"text":"みんな疲れ果てた時に1日嫁のいない休みがあったら何してる？"},{"br":1},{"color":"rgb(42, 18, 138)","size":16,"bold":true,"text":"夜の店とか行ってみようかな。"}],[{"size":16,"bold":true,"color":"mediumblue","text":">>461"},{"br":1},{"size":16,"bold":true,"text":" 温泉と夜の店と飲み "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>461"},{"br":1},{"size":16,"bold":true,"text":" 自転車乗る→昼前に帰ってシャワー "},{"br":1},{"size":16,"bold":true,"text":" 昼飯食って寝る "},{"br":1},{"size":16,"bold":true,"text":" 起きてから自転車乗る→帰ってシャワー "},{"br":1},{"size":16,"bold":true,"text":" 洗濯しながら夜飯作って食って寝る "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>461"},{"br":1},{"size":16,"bold":true,"text":" 涼しい季節なら、ソロキャンプして焚き火とランタンの火を見つめる "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>461"},{"br":1},{"size":16,"bold":true,"text":" とりあえず外出て何かしらしてみろ "},{"br":1},{"size":16,"bold":true,"text":" 意外と気分転換になるぞ "},{"br":1},{"color":"gray","size":12,"text":"編集元: "},{"color":"gray","size":12,"text":"結婚生活に疲れた人・・・93人目 "}]],"comments":[]}