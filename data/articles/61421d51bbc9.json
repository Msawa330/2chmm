, 51)","text":"それは風評被害や "}],[{"bold":true,"color":"rgb(51, 51, 51)","text":" ﾔｯﾃﾔﾙﾃﾞｽ "}],[{"bold":true,"color":"rgb(51, 51, 51)","text":" あずにゃんはむしろ処理した側なんだよなぁ "}],[{"bold":true,"color":"rgb(51, 51, 51)","text":" マーキング定期 "}],[{"bold":true,"color":"rgb(51, 51, 51)","text":" 冤罪定期 "}],[{"img":"https://livedoor.sp.blogimg.jp/kinisoku/imgs/e/2/e22b181d.jpg"}],[{"bold":true,"color":"rgb(51, 51, 51)","text":" こいつって貧乏だと思ってたけどドーナツこんな買えるほど金持ちだったのか "}],[{"bold":true,"color":"rgb(0, 0, 102)","text":" てか今この数かったら7、8000円しそう "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>124"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"流石に4000円くらいやろ "}],[{"bold":true,"color":"rgb(0, 0, 102)","text":" 誕生日：11月11日（1992年生まれ） "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>144"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"おばちゃんやん "}],[{"bold":true,"color":"rgb(0, 0, 102)","text":" 見たことないけどこれどういうシーンなの "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>149"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"3年が修学旅行に出払っている時に友達の家に遊び行ったんだけどそこで鈴木って奴が買ってきたドーナツを🐀の如く齧り食いしてたしーん "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>172"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"普通にクズやん "}],[{"img":"https://livedoor.sp.blogimg.jp/kinisoku/imgs/1/3/134bee40.jpg"}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>178"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"さわちゃん教科書の君が代のページに紙貼らせてきそう定期 "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>189"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"草 "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>178"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"ニコニコで見た "}],[{"bold":true,"color":"rgb(0, 0, 102)","text":" 謎の勢力「むぎちゃんは現代なら一番人気になる」"},{"br":1},{"bold":true,"color":"rgb(0, 0, 102)","text":"ならないぞ "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>197"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"現代ならむぎちゃんが1位だし朝比奈みくるが1位や"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"ママを求めてるからな "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>203"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"ほんならならへんな"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"特にみくる "}],[{"bold":true,"color":"rgb(0, 0, 102)","text":" 先輩のみんながかじったドーナツを処理してるだけなのにこの叩かれよう"},{"br":1},{"bold":true,"color":"rgb(0, 0, 102)","text":"池沼の先輩を叩けよ "}],[{"bold":true,"color":"rgb(51, 51, 51)","text":" サンジュは二期でおでこ広げられてなかったら確実に覇権だった "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>206"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"ギターが弾けるだけのみいちゃん"},{"br":1},{"img":"https://livedoor.blogimg.jp/kinisoku/imgs/8/e/8e8abd46.gif"}],[{"bold":true,"color":"rgb(255, 0, 0)","text":" かわいいのでセーフ "}],[{"bold":true,"color":"rgb(51, 51, 51)","text":" たくあん居なかったら何も出来ない連中🥺 "}],[{"bold":true,"color":"rgb(51, 51, 51)","text":" 唯というギターの天才に隠れた憂という真の天才 "}],[{"bold":true,"color":"rgb(0, 0, 102)","text":" けいおんが今放送されてたらまったく流行ってないだろうな "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>252"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"日常系は好み別れるところだから分からないけど曲は今でも流行りそうではある "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>260"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"現代ではshortで印象残せる曲しか流行らないよ "}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>252"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"むしろバンドアニメ全盛期やし流行るよ"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":"今やって流行らなさそうなのはどっちかというとハルヒ "}],[{"img":"https://livedoor.sp.blogimg.jp/kinisoku/imgs/0/a/0aebcae8.jpg"},{"br":1},{"bold":true,"color":"rgb(0, 0, 102)","text":"でもかわいいよね？ "}]],"comments":["あずにゃんの声でやってよwww","けいおんリメイクしたら人気でないかな\n曲とか追加して","ギャグにマジレスするのほんまおもろい\nコロコロのマリオくんが野グソするボケしたら育ちが悪いって注意してんのと一緒なのに",">>20\nそもそも全部かじったのこいつじゃないぞ","なかのひと時計泥棒やしな","ぼくこれほしい","ぼくもほしい","育ち悪い奴が作ってるんだろうな\n漫画家は家庭崩壊してる家の奴が多い",">>3\n答え映さないからこういうのが出てきちゃうじゃん？","モジャ毛が1番"]}