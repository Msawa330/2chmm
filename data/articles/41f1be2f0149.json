{"id":"41f1be2f0149","publishedAt":1795203131000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/diet2channel/imgs/5/8/588c4991.jpg"}],[{"color":"#0000cd","size":16,"bold":true,"text":" 教えて欲しいか "}],[{"size":16,"bold":true,"text":" ※ただしハゲます "}],[{"size":16,"bold":true,"text":" 食べない "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 食事制限一切なしだぞ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 運動は筋トレだけ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" まず血液中のコレステロールを下げる食べ物に注目したんだ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" リコピン DHA EPAが有名だと思う "}],[{"color":"#0000cd","size":16,"bold":true,"text":" まずDHA EPAから "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 必須脂肪酸ってのがあって体内で作ることのできない油のことね "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" オメガ系3種（DHAEPA） "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" オメガ系6種（オレイン酸） "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" オメガ系9種（リノール酸） "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" ってのがある "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>9"},{"br":1},{"size":16,"bold":true,"text":" オメガ9がオレイン酸な "},{"br":1},{"bold":true,"text":"■補足"},{"br":1},{"size":14,"text":"オメガ系6種→リノール酸、オメガ系9種→オレイン酸"}],[{"size":16,"bold":true,"text":" 聞いてないのに話し出した "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 現代の欧米型食生活だとオメガ系6種が過剰摂取になってるんだよ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" バターサラダオイルなんかにも含まれているから "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 普通の食事をしているとオメガ系6種しかとれない "}],[{"color":"#ff3366","size":16,"bold":true,"text":" 食事制限してるやん "}],[{"color":"#0000cd","size":16,"bold":true,"text":" オメガ系6種を過剰摂取すると血中のコレステロールが上がり "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 肥満や思考力低下なんかの症状が出る "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" そこで現代日本人に摂取して欲しいのがオメガ系3種のDHAEPA "}],[{"size":16,"bold":true,"text":" 俺はオメガ3は青魚で "},{"br":1},{"size":16,"bold":true,"text":" オメガ9はオリーブ油で摂ってるぞ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" オレイン酸は"},{"color":"mediumblue","size":16,"bold":true,"text":">>16"},{"color":"#0000cd","size":16,"bold":true,"text":"の言う通りオリーブオイルで代用できる "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 効能は良く知らんけど6種を9種に代用するだけで6種の摂取を制限できる "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 青魚なんかの油なんだけど普通に摂るのがめんどいのでサプリで代用する "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 1日の摂取オイルをDHAEPA1オレイン酸3の割合を目指すんだ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" そうするだけで痩せやすい体質ができる "}],[{"size":16,"bold":true,"text":" 経口摂取じゃないから桶 "},{"br":1},{"size":16,"bold":true,"text":" とでも言うのか？ "}],[{"size":16,"bold":true,"text":" 良質の脂質を摂りたいならならナッツ類をおやつ代わりにつまんで食うのでも可 "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 次に重要なのがリコピンね "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" これはトマトジュースで手軽に摂取できる "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 血中のコレステロールを下げる効果がある "}],[{"color":"#0000cd","size":16,"bold":true,"text":" トマトジュースがなんで優れているかというと "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 食前20分前に飲むことによって食事による血糖値の上昇を "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 半分くらいに抑えてくれるんだ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" これが今流行ってるべジファーストね "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" リコピンで血中コレステロールを下げて血糖値の上昇も抑えてくれる夢の飲料 "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" それがトマトジュースなんだ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 次に重要なのがタンパク質ね "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 一日に必要な量ってのが運動習慣がない人で "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 体重70㎏くらいの場合でも100gが目安とされている "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 鳥のささみ10切れ分にも相当するんだけど "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" これを毎日なんてとてもじゃないけど無理 "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" そこでお勧めするのがホエイプロテインなんだ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 運動してない奴がプロテインwなんて思うかもしれないが "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" アメリカの臨床実験でホエイプロテインを毎日40g摂取させたら "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 運動や筋トレを全くしてない人でも体脂肪率が2ヶ月で最大9％落ちたという報告がる "}],[{"color":"#0000cd","size":16,"bold":true,"text":" この研究結果を元に生み出したわいのダイエットが "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 朝食前にホエイプロテイン20gとトマトジュースを割ったものを飲む "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 朝食後にDHAEPAのサプリを飲む "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 夕食前にホエイプロテイン20ｇとトマトジュースを割ったものを飲む "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 各種筋部の筋トレ20回×3セットを週2回 "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" これで2週間で78㎏から70㎏に落ちたんだ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 糖質の制限してないぞ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" トマトジュースで血糖値の上昇を抑えるだけ "}],[{"color":"#ff3366","size":24,"bold":true,"text":" 食事制限一切無しなんてものはこの世に存在しない"},{"br":1},{"bold":true,"color":"rgb(255, 51, 102)","text":"▼アクセスの多い関連記事"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/61800702.html","color":"rgb(0, 102, 204)","text":"2週間で7㎏痩せるダイエット方法がこれ"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/61213093.html","color":"rgb(0, 102, 204)","text":"2週間で7㎏痩せたダイエット法がこちらです"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/60440810.html","color":"rgb(0, 102, 204)","text":"一人暮らし「ククク...サバ缶はDHA・ミネラル・ビタミンそしてカルシウムが含まれている完全食だァ」"},{"br":1},{"color":"gray","text":"引用元:"},{"color":"gray","text":"http://viper.2ch.sc/test/read.cgi/news4vip/1550629395/"},{"br":1},{"text":"<url>"},{"text":"<title>"}]],"comments":[]}