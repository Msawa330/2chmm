{"id":"66b6fb54da84","publishedAt":1795668257000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/diet2channel/imgs/d/c/dc91741a.png"}],[{"color":"#0000cd","size":16,"bold":true,"text":" 江戸時代やとギリストーブあるか？ "}],[{"size":16,"bold":true,"text":" 火鉢 "}],[{"size":16,"bold":true,"text":" 七輪 "}],[{"color":"#008000","size":16,"bold":true,"text":" 囲炉裏やろ "}],[{"size":16,"bold":true,"text":" 五右衛門風呂をご存知でない？ "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>6"},{"br":1},{"size":16,"bold":true,"text":" あの頃て蒸し風呂やないんか "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>6"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 風呂入ったまま寝てたってコト？ "}],[{"size":16,"bold":true,"text":" どうやって火起こしてたんだろう "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>7"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 多分ライターあったと思うよ "}],[{"color":"#dc143c","size":16,"bold":true,"text":" 家の中で暖炉でもないのにバッチバチに火を燃やしてたって今考えると凄いな "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>8"},{"br":1},{"size":16,"bold":true,"text":" ガスコンロ無いの？ "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>8"},{"br":1},{"size":16,"bold":true,"text":" 薪燃やすとかは農家みたいな田舎の家だけやろ "},{"br":1},{"size":16,"bold":true,"text":" 火鉢なら都市でも使えるが囲炉裏じゃ煙も煤もヤバい "}],[{"size":16,"bold":true,"text":" 普段着の綿をマシマシにした "},{"br":1},{"size":16,"bold":true,"text":" 実際暖を取れない人はちょこちょこ死んでたらしい "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>9"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 綿って当時高級品やろ？ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" どうやって詰めてたんやろ "}],[{"size":16,"bold":true,"text":" 家が隙間だらけやしよく生きてたと思うわ "}],[{"size":16,"bold":true,"text":" 炭の持ってるエネルギー調べた事あるけど "},{"br":1},{"size":16,"bold":true,"text":" 炭一個とかじゃぜんぜんエネルギー低いね "},{"br":1},{"size":16,"bold":true,"text":" 薪ストーブみたいにガンガン燃やさないとやっぱ部屋は暖まらない "}],[{"size":16,"bold":true,"text":" youtubeで見たわエアコンあったらしいで "}],[{"color":"#008000","size":16,"bold":true,"text":" 火打石「カチ…カチ…」 "},{"br":1},{"color":"#008000","size":16,"bold":true,"text":" ↑ "},{"br":1},{"color":"#008000","size":16,"bold":true,"text":" こんなんマジでやってたんか？ "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>22"},{"br":1},{"size":16,"bold":true,"text":" 他なければそうやけど、普段の生活は大体隣とかから火分けてもらう "}],[{"size":16,"bold":true,"text":" 一酸化炭素の知識あったんかな "}],[{"size":16,"bold":true,"text":" 天守閣とか相当寒いよな "}],[{"size":16,"bold":true,"text":" 乾布摩擦ってやつだろ "}],[{"size":16,"bold":true,"text":" 当時の人って夜中に起きて囲炉裏なりの火を継ぎ足すのが当たり前だったみたい "},{"br":1},{"size":16,"bold":true,"text":" 朝まで起きずに寝るようになったのって明治以降なんやって "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>34"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 江戸時代の人に聞いたんか？ "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>37"},{"br":1},{"size":16,"bold":true,"text":" そいつ125歳やぞ "}],[{"size":16,"bold":true,"text":" 自販機で缶コーヒーやぞ "}],[{"size":16,"bold":true,"text":" 江戸時代で死ぬなら原始時代どうやって生き延びてた "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>39"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" ほぼ猿だったからな "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 体毛でなんとかなってたらしいで "}],[{"size":16,"bold":true,"text":" 昔は寒くない "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>43"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 今より寒かったらしいで "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>48"},{"br":1},{"size":16,"bold":true,"text":" はあ？お前江戸時代経験したの？ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>49"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 江戸時代の人達が昔は今よりも寒かったって書いてある絵日記があんねん "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>52"},{"br":1},{"size":16,"bold":true,"text":" どうやって今を知ったの？ "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>43"},{"br":1},{"size":16,"bold":true,"text":" 江戸時代は真夏でようやく30℃くらいのプチ氷河期や "}],[{"color":"#ff3366","size":16,"bold":true,"text":" 昔から暑さ、寒さに強い奴だけ生き残って来たんやろな "},{"br":1},{"color":"#ff3366","size":16,"bold":true,"text":" 弱い奴は死んで行った "},{"br":1},{"bold":true,"color":"rgb(255, 