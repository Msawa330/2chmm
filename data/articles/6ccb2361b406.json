{"id":"6ccb2361b406","publishedAt":1795358707000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/news4vip2/imgs/4/b/4b40e1fe.jpg"},{"br":1},{"text":"閲覧注意！激ヤバ！本当に怖い話"}],[{"color":"#111111","size":18,"bold":true,"text":"諦めてそっち行ったらええんやないの？"}],[{"color":"#1f32ff","size":18,"bold":true,"text":">>6"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"これはチケットと一緒についてくる手数料明細みたいなもんやから違うフェスのチケットってわけじゃない"}],[{"color":"#111111","size":18,"bold":true,"text":"いい勉強になったじゃん"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"粗忽で損するのが人生なんだよアニメや漫画の見過ぎで勘違いしちゃいけない"}],[{"color":"#111111","size":18,"bold":true,"text":"サマソニって電子チケットじゃないのかよ"}],[{"color":"#1f32ff","size":18,"bold":true,"text":">>9"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"書いてる事読めないような奴がそんな事できると思うか？"}],[{"color":"#111111","size":18,"bold":true,"text":"手数料券と入場券って一緒の封筒で渡されるのになんであえて入場券の方だけ抜いてきたの？"}],[{"color":"#111111","size":18,"bold":true,"text":"電車の切符じゃなくてクレジットカード控えを持ってった、みたいな？"}],[{"color":"#111111","size":18,"bold":true,"text":"私女ですけども通用せず入れなかったから何とかバズらせて入ろうとしたか"}],[{"color":"#111111","size":18,"bold":true,"text":"正規のチケットとは別にバズ用にこっちの使えない奴も持って行ってぇ…ｗ"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"入場前に写真撮ってぇ…ｗ"}],[{"color":"#111111","size":18,"bold":true,"text":"話聞こか？"}],[{"color":"#111111","size":18,"bold":true,"text":"普通全部持ってくからバズり用やろ"}],[{"color":"#111111","size":18,"bold":true,"text":"罠やん"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"他にも同じミスした人多いやろ"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"こんなチケットっぽい手数料券にする必要ないやん"}],[{"color":"#1f32ff","size":18,"bold":true,"text":">>23"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"紙のチケットは普通これやで"}],[{"color":"#1f32ff","size":18,"bold":true,"text":">>23"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"それでぼったくってる商売やし"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"予約で500円"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"発券で300円とかやぞ"}],[{"color":"#111111","size":18,"bold":true,"text":"チケ間違いじゃないけど初期のサマソニで二日目のオープニングアクトがモンパチだった時あったんだけど"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"モンパチ始まってもチケット交換が長蛇の列で泣き叫んでる子が大勢居たの思い出した"}],[{"color":"#111111","size":18,"bold":true,"text":"擁護はせんけどこのチケットと同じ用紙の領収書とか明細とかマジで害悪だよな"}],[{"color":"#111111","size":18,"bold":true,"text":"入れないチケットってどう言う事だよ"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"システムが分からん"}],[{"color":"#1f32ff","size":18,"bold":true,"text":">>34"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"同じことやる素質あるよ"}],[{"color":"#d90000","size":18,"bold":true,"text":"馬鹿は自分の趣味すら満足にこなせない"}]],"comments":["プリン永久追放","せや！手数料券だけ映して入れないってポストしたろ！","新幹線の磁気チケット買った時に出てくる領収書で乗車しようとする感じか","興行チケット業界も未だにシステム利用料だの発見料（デジタルでも徴収）だの、古い商売やってるんだよな"]}