{"id":"a3f5b803c531","publishedAt":1794291137000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/7/e/7e68bed5.jpg"}],[{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"\n本物ワレは優しいな"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"🙌 "},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"href":"https://t.co/YCy9lFLDah","text":"pic.twitter.com/YCy9lFLDah"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"— ちいかわ💫アニメ火金 (@ngnchiikawa) "},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"href":"https://x.com/ngnchiikawa/status/2119790294732517880?ref_src=twsrc%5Etfw","text":"2026年11月9日"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\nハァ～？"}],[{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\n実際どうすんだよこれ…"}],[{"bold":true,"text":"\n可愛すぎる…"},{"br":1},{"bold":true,"text":"\n早くグッズ化しろ"}],[{"bold":true,"text":"\n>>3"},{"br":1},{"bold":true,"text":"\nハチワレくじのE賞に入れるか"}],[{"bold":true,"text":"\nパピコだれが食べたんだよ！"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\n哀ワレ好き"}],[{"bold":true,"text":"\n水色がかわいいが緑も良い…"}],[{"bold":true,"text":"\n哀ワレが特に可愛い"}],[{"bold":true,"text":"\nなんでこんなに増殖したんだろう…パピコで"}],[{"bold":true,"text":"\nなんか思ったより問題無さそうだな"},{"br":1},{"bold":true,"text":"\n元のハチワレからその感情欠けてるとかも無さそうだし"}],[{"color":"rgb(219, 0, 0)","bold":true,"text":"\n怒なのにやけに大人しいな"}],[{"bold":true,"text":"\n>>11"},{"br":1},{"bold":true,"text":"\nまあ所詮ハチワレの怒だし…"}],[{"bold":true,"text":"\n>>12"},{"br":1},{"bold":true,"text":"\n所詮ってハチワレを下に見すぎてて好き"}],[{"bold":true,"text":"\n>>160"},{"br":1},{"bold":true,"text":"\nムム…😡"}],[{"bold":true,"text":"\n>>160"},{"br":1},{"bold":true,"text":"\n見下してるんじゃなくて愛らしいよねってことでは"}],[{"bold":true,"text":"\n喜怒哀楽なんだろうけど残った青いのは何だ"}],[{"bold":true,"text":"\n>>14"},{"br":1},{"bold":true,"text":"\nホンモノ"}],[{"bold":true,"text":"\nたのしそう"}],[{"bold":true,"text":"\nハチワレはいいやつだが今ちいかわより危機感ないぞ"}],[{"bold":true,"text":"\n怒ワレ険しい顔をしてるけど言うほど怒ってはいない"}],[{"color":"rgb(240, 98, 2)","bold":true,"text":"\n本物が楽担当すぎない…？"}],[{"bold":true,"text":"\nハチワレ四天王"}],[{"bold":true,"text":"\n哀が可愛すぎる"}],[{"bold":true,"text":"\nうさぎはなんやねんその態度"}],[{"bold":true,"text":"\n>>25"},{"br":1},{"bold":true,"text":"\nこいつは平常運転だろ"}],[{"bold":true,"text":"\n>>25"},{"br":1},{"bold":true,"text":"\nﾌｩﾝ？"}],[{"bold":true,"text":"\n哀ワレも泣いてるけどそんな悲しそうでもない"}],[{"bold":true,"text":"\n>>26"},{"br":1},{"bold":true,"text":"\nパピコ食ったもんな"}],[{"bold":true,"text":"\nなんだそのうさぎの座り方"}],[{"bold":true,"text":"\nおこワレ"},{"br":1},{"bold":true,"text":"\nどワレ"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nちいかわのえぇ……って顔がよすぎる"}],[{"bold":true,"text":"\n…これ長期戦になりそうだな？"}],[{"bold":true,"text":"\nなんか元のハチワレになんも変化ないから楽が2匹いる感じだな…"}],[{"bold":true,"text":"\nわムゥ"}],[{"bold":true,"text":"\n腕組み怒ワレがかなり可愛い"}],[{"bold":true,"text":"\n>>35"},{"br":1},{"bold":true,"text":"\n儚く見えてきた"}],[{"bold":true,"text":"\nハァ～？が結構マジで何言ってんだこいつのハァ～だ…！"}],[{"bold":true,"text":"\nうさぎすらハァ～？って言ってる…"}],[{"bold":true,"text":"\n何されても対応する感情しか表現できないなら一緒に生活するの辛そうだな"}],[{"bold":true,"text":"\nこいつらがどこから発生したのかわからんけど"},{"br":1},{"bold":true,"text":"\nオリジナルが怒ってるの見た記憶が無い"}],[{"bold":true,"text":"\n映る度に色んなポーズしてるうさぎで笑う"}],[{"bold":true,"text":"\nやっぱさ喜と楽ってかぶってるよね？"}],[{"bold":true,"text":"\nこの話始まってからちいかわずっと引いててダメ"}],[{"bold":true,"text":"\n喜と楽と本体みんな同じじゃない？"}],[{"bold":true,"text":"\nかわいすぎてファンアー"}]],"comments":["ワイは単純な男なので泣きワレちゃんに興奮してます","ちいかわずっとマジかお前って顔してんのおもろい","モナ王ずっと引きまくってて笑っちゃう"]}