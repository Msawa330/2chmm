{"id":"be94b8f35835","publishedAt":1794835619000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/8/e/8e51c692.jpg"}],[{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"\nかなしい…"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"🙌 "},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"href":"https://t.co/QRkr9Dw57M","text":"pic.twitter.com/QRkr9Dw57M"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"— ちいかわ💫アニメ火金 (@ngnchiikawa) "},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"href":"https://x.com/ngnchiikawa/status/2121946495964549195?ref_src=twsrc%5Etfw","text":"2026年11月15日"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"🙌 "},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"href":"https://t.co/QRkr9Dw57M","text":"pic.twitter.com/QRkr9Dw57M"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"— ちいかわ💫アニメ火金 (@ngnchiikawa) "},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"href":"https://x.com/ngnchiikawa/status/2121946495964549195?ref_src=twsrc%5Etfw","text":"2026年11月15日"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\n遅かったみたい。"},{"br":1},{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\nもう…"}],[{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\n>>2"},{"br":1},{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\n終"}],[{"bold":true,"text":"\n助かる流れだろ！"}],[{"bold":true,"text":"\n>>3"},{"br":1},{"bold":true,"text":"\n多分悲しいの方が勝って心から笑えてないんだろう"}],[{"bold":true,"text":"\nあ～い～好き"}],[{"bold":true,"text":"\n>>5"},{"br":1},{"bold":true,"text":"\nなんなんこれ！？"}],[{"bold":true,"text":"\n>>15"},{"br":1},{"bold":true,"text":"\n悪夢編の最後に見た夢のハチワレの動きかな"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\n今気づいたのかよ"}],[{"bold":true,"text":"\n>>6"},{"br":1},{"bold":true,"text":"\nパピコ買ったら急に出てきた奴らが突然消えたとしてまさか自分の感情とリンクしてるとは思わんだろ"}],[{"bold":true,"text":"\n笑わせるな"}],[{"bold":true,"text":"\n笑わせてくれるの優しい"}],[{"color":"rgb(219, 0, 0)","bold":true,"text":"\n怒チワレは長生きできそう"}],[{"bold":true,"text":"\n>>11"},{"br":1},{"bold":true,"text":"\nこの後物凄く怒りたくなる出来事がひっきりなしに来るけどずっと抑え続けてストレスためて怪異化しかけるとかやりかねない"}],[{"bold":true,"text":"\n>>32"},{"br":1},{"bold":true,"text":"\nそこで肩叩いてもう良いって首振りながら消えていく怒ワレ"}],[{"bold":true,"text":"\n美しい…"}],[{"bold":true,"text":"\nまたスタンプになりそうなハチワレが"}],[{"bold":true,"text":"\nもう…"}],[{"color":"rgb(240, 98, 2)","bold":true,"text":"\nうさぎ本当好き"}],[{"bold":true,"text":"\nこの状況で「おもしろいッ」て笑えるハチワレやっぱおかしいわ…"}],[{"bold":true,"text":"\n冷静だなライ助…"}],[{"bold":true,"text":"\n最後のコマの台詞もすごいけどその表情にするのが独特すぎる…"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\nちいかわは何をしてえんだよ"},{"br":1},{"color":"rgb(181, 12, 205)","bold":true,"text":"\nア～イ～じゃねえよ"}],[{"bold":true,"text":"\n>>21"},{"br":1},{"bold":true,"text":"\n面白いことして！って急に言われて対応できる人だけが石を投げなさい"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\nモナ王ずっと困惑してんな"}],[{"bold":true,"text":"\n>>22"},{"br":1},{"bold":true,"text":"\nモナ王からしたら始終意味不明だし"}],[{"bold":true,"text":"\n使いやすいな"}],[{"bold":true,"text":"\n怒りなんてあるのか？"}],[{"bold":true,"text":"\n最後のコマのモナ王はどういう感情なんだよ"}],[{"color":"rgb(240, 98, 2)","bold":true,"text":"\nパピコ買っただけでこんな話になるかよ"}],[{"bold":true,"text":"\nあんまり哀しんでないだろコイツ"}],[{"bold":true,"text":"\nここ最近リアクション芸人になってる気がするぞモナ王"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nうさぎのそれ絶対面白いからずるいだろ"}],[{"bold":true,"text":"\nちゃんとうさぎも笑わせようと協力してくれるのな"}],[{"bold":true,"text":"\n怒ワレどうすんだよ…まあいても困らないけど…"}],[{"bold":true,"text":"\nモナ王はそれ何のギャグだよ"}],[{"bold":true,"text":"\nしばらく帯同してここぞというときに消えるのか怒ワレ"}],[{"bold":true,"text":"\n切り替え早いなハチワレ"}],[{"bold":true,"text":"\n一応あれを\"悲しそうな自分\"ってちゃんと認識してたんだな"}],[{"bold":true,"text":"\n怒ったら赤が消えるのか？"}],[{"color":"rgb(148, 21, 76)","bold":true,"text":"\n別に助けたとてじゃねえの…？"}],[{"bold":true,"text":"\n今回のモナ王だいぶ新しい言葉喋ってるな…"}],[{"bold":true,"text":"\nウサギが意表突かれた反応してるの珍しいな"},{"br":1},{"text":"46"},{"color":"#696969","size":12,"text":" ："},{"color":"#009900","size":12,"text":"ななしさん"},{"color":"#696969","size":12,"text":" ：26/11/16("}]],"comments":["ほんの一瞬でも怒れば良さそうなので何かの拍子で消えそう",">>1\n常日頃からちいかわには苛ついてそうだから割とすぐ消えるだろうね",">>5\n友達にはそうそう怒らんやろ…\nどちらかと言うと［どこからでも切れます］とかに怒りそう"]}