{"id":"b7156b42ec9c","publishedAt":1794096743000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/itsoku/imgs/9/3/93a979a9.png"}],[{"text":"https://www.youtube.com/embed/hcMSYK4kDHQ?si=B_CEnNOC8NddMrUa","href":"https://www.youtube.com/embed/hcMSYK4kDHQ?si=B_CEnNOC8NddMrUa"}],[{"color":"#0000cd","size":18,"bold":true,"text":" どーすんのこれ😰"}],[{"size":18,"bold":true,"text":" デカい地震ないからあんまみんな対策してなかったんやろ "}],[{"size":18,"bold":true,"text":" 震度4でガラス割れたん?"},{"br":1},{"size":18,"bold":true,"text":"欠陥ちゃうか "}],[{"size":18,"bold":true,"text":" 震度5強以上ありそう "}],[{"color":"#ff0000","size":18,"bold":true,"text":" 愛知で地震て珍しいね "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>10"},{"br":1},{"size":18,"bold":true,"text":"南海トラフつうと激震地になりそうなのにな "}],[{"size":18,"bold":true,"text":" 一部地下鉄遅延してるらしい出勤の人は大変だ "}],[{"size":18,"bold":true,"text":" 本屋の荷崩れはしゃーない"},{"br":1},{"size":18,"bold":true,"text":"アウディジャパンの窓ガラスはワンチャン敢えてガラスを犠牲にして建物は問題が起きない構造なのかも知れない"},{"br":1},{"size":18,"bold":true,"text":"（割れたガラスで怪我をする事を考慮していないが）"},{"br":1},{"size":18,"bold":true,"text":"メディアは酷い被害の所だけを取り上げ過ぎやから知り合いが居たら聞いた方が良いよ "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>14"},{"br":1},{"size":18,"bold":true,"text":"震度4で割れるのは設計がやべぇやろ誤報で地震5だとしても事業所としてはあかんわ"},{"br":1},{"size":18,"bold":true,"text":"地震ほぼないドイツ基準で建てたんちゃうか "}],[{"color":"#0000cd","size":18,"bold":true,"text":" アウディを潰すためのトヨタの人工地震や "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>16"},{"br":1},{"size":18,"bold":true,"text":"逆やろ "}],[{"size":18,"bold":true,"text":" 愛知だけに、おわりやな "}],[{"size":18,"bold":true,"text":" まだ序章やで "}],[{"size":18,"bold":true,"text":" 震度5弱地域民やがめっちゃ揺れたわ"},{"br":1},{"size":18,"bold":true,"text":"人生で最大の揺れやった "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>23"},{"br":1},{"size":18,"bold":true,"text":"わかる "}],[{"color":"#ff0000","size":18,"bold":true,"text":" たった5強で "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>35"},{"br":1},{"size":18,"bold":true,"text":"愛知はあんま地震こんから皆驚いたのよ "}],[{"size":18,"bold":true,"text":" 南海トラフ地震はもう始まってるんだよね "}],[{"size":18,"bold":true,"text":" 確かに愛知で5強はあんまり聞かないな "}],[{"color":"#0000cd","size":18,"bold":true,"text":" ドラゴンズは無事か？ "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>66"},{"br":1},{"size":18,"bold":true,"text":"無事6位や "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>68"},{"br":1},{"size":18,"bold":true,"text":"草 "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>68"},{"br":1},{"size":18,"bold":true,"text":"よかった正常値や "}],[{"color":"#ff0000","size":18,"bold":true,"text":" ワイ豊田市民まあまあ揺れた "}],[{"size":18,"bold":true,"text":" なんか体感震度3ぐらいだったけどなぁ "}],[{"size":18,"bold":true,"text":" 正直知多らへんの人はやばそう"},{"br":1},{"size":18,"bold":true,"text":"特にジジババ "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>85"},{"br":1},{"size":18,"bold":true,"text":"半島は救助にもいきにくいからな "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>90"},{"br":1},{"size":18,"bold":true,"text":"ほんそれ"},{"br":1},{"size":18,"bold":true,"text":"耐震工事の大事さがわかった "}],[{"color":"#ff0000","size":18,"bold":true,"text":" 5強でそこまで被害でるイメージなかったけどあまり地震が無い地域だったみたいやな"},{"br":1},{"color":"#ff0000","size":18,"bold":true,"text":"マグニチュードも6すらいってなかったやろ？ "}],[{"size":18,"bold":true,"text":" ワイのとこ地震起きてたんやな"},{"br":1},{"size":18,"bold":true,"text":"その時爆睡やったわ "}],[{"size":18,"bold":true,"text":" 地震のせいで電車の本数少なくなってんのゴミすぎる "}],[{"size":18,"bold":true,"text":" やばいやろ "}],[{"size":18,"bold":true,"text":" 南海トラフの前兆にならんとええんやけどな "},{"br":1},{"text":"元スレ: "},{"text":"https://hayabusa.open2ch.net/test/read.cgi/livejupiter/1794091875/"}]],"comments":["子供の下宿先が震度5でしたが、無事を確認できました(´・ω・`)","熊本よりダメージなさそうだが","浜名湖沿岸の民だが物が落ちてくるような揺れじゃなかった\n地震って不思議ね"]}