[{"bold":true,"text":"\nこの理不尽な世界に怒りが湧く"}],[{"bold":true,"text":"\nモナ王は今日だけで叫びすぎて喉死なない"}],[{"bold":true,"text":"\n消滅エフェクトもなんかリッチになってない？"}],[{"bold":true,"text":"\n>>22"},{"br":1},{"bold":true,"text":"\n実は見てなかっただけで緑もこう消えてたかも"}],[{"bold":true,"text":"\nちょっと哀ワレのキャラが立ちすぎてる"}],[{"bold":true,"text":"\nなんか映画で頼りがいのあるやつだと思ってたパスタが"},{"br":1},{"bold":true,"text":"\nあほの権化だったことを忘れていた"}],[{"bold":true,"text":"\n完全に消えたらモナ王も黄ワレの事忘れちゃうのかな…"}],[{"bold":true,"text":"\n幸せそうに消えてて良かった…"}],[{"bold":true,"text":"\nリアクション芸人すぎる"}],[{"bold":true,"text":"\n儚いだろ！！！が頭を何度もよぎった"}],[{"bold":true,"text":"\n>>32"},{"br":1},{"bold":true,"text":"\nもうお前は…会えないだろ！！！"},{"br":1},{"bold":true,"text":"\n本当に会えなそう…"}],[{"bold":true,"text":"\n他ワレが消えたことに本物が気づいたら哀しんで哀ワレ消えそう"}],[{"color":"rgb(219, 0, 0)","bold":true,"text":"\n消えるの早すぎだろ！"}],[{"bold":true,"text":"\n楽しいって発声が発動条件ではなかったんだな"}],[{"bold":true,"text":"\n全部消えたらライ助が無感情に？"}],[{"bold":true,"text":"\nｽｩｰｯ"}],[{"bold":true,"text":"\nまさか哀ワレがこんな事してくれるなんて"}],[{"bold":true,"text":"\n>>39"},{"br":1},{"bold":true,"text":"\n見かけによらず頼もしいぜ哀ワレ…！"}],[{"bold":true,"text":"\n儚いだろ…"}],[{"bold":true,"text":"\n緑薄ら消えてんの気付かなかった…"}],[{"bold":true,"text":"\n>>42"},{"br":1},{"bold":true,"text":"\n前のラストのコマで薄くなってる"}],[{"color":"rgb(240, 98, 2)","bold":true,"text":"\nあのパピコがいいやつなのか悪いやつなのか判断に困る"}]],"comments":["モナ王のこと初めて可愛いと思ったかも","ただのだるまさんがころんだなのに内Ｐの露天風呂を思い出してしまう","消えちゃった!!!"]}