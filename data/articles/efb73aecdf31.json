{"id":"efb73aecdf31","publishedAt":1794574849000,"posts":[[{"size":10,"text":"1 "},{"size":10,"text":"2026/11/07(土)"},{"br":1},{"size":18,"text":"\n昭和生まれさん、上着のことをジャンバーと言っていた"},{"br":1},{"size":18,"text":"\nダサくて草 "},{"br":1},{"size":10,"text":"2 "},{"br":1},{"size":24,"color":"#CC3333","text":"ジャン「パ」ーやで　"},{"br":1},{"size":10,"text":"29 "},{"br":1},{"size":18,"color":"#006699","text":"ジャンパーでいいやろ "},{"br":1},{"size":18,"color":"#006699","text":" 革ジャンGジャンは定着してるんやし "},{"br":1},{"size":10,"text":"5 "},{"br":1},{"size":18,"text":"\n今は言わんけど確かに言うとった！ "},{"br":1},{"size":18,"text":"ジャンパーってなに？ "},{"br":1},{"size":10,"text":"3 "},{"br":1},{"size":18,"text":"\n地元で買ったジャンパー "},{"br":1},{"size":10,"text":"4 "},{"br":1},{"size":18,"text":"\n平成生まれワイ「アウター」 "},{"br":1},{"size":10,"text":"7 "},{"br":1},{"size":18,"text":"\nズボン "},{"br":1},{"size":10,"text":"8 "},{"br":1},{"size":18,"text":"\nジャケットやろ "},{"br":1},{"size":10,"text":"9 "},{"br":1},{"size":18,"text":"\nおべべ "},{"br":1},{"size":10,"text":"12 "},{"br":1},{"size":18,"text":"\n外套 "},{"br":1},{"size":10,"text":"13 "},{"br":1},{"size":18,"text":"\n上着やろ "},{"br":1},{"size":10,"text":"14 "},{"br":1},{"size":18,"text":"\n他の呼び方だと微妙にズレるやろ "},{"br":1},{"size":10,"text":"21 "},{"br":1},{"size":24,"color":"#CC3333","text":"｢ズボン｣は使って大丈夫？"},{"br":1},{"size":10,"text":"26 "},{"br":1},{"size":18,"color":"#006699","text":">>21"},{"br":1},{"size":18,"color":"#006699","text":"オッサン乙"},{"br":1},{"size":10,"text":"27 "},{"br":1},{"size":18,"text":"\nいまなんて言うの？ "},{"br":1},{"size":10,"text":"30 "},{"br":1},{"size":18,"text":"\nジャンパーだとジャンプする人にしか聞こえんからな "},{"br":1},{"size":18,"text":" ブルゾンと言われるともっとフォーマルなものになるしな "},{"br":1},{"size":18,"text":" ジャンバーがちょうど良い "},{"br":1},{"size":18,"text":" 上着というと背広だ "},{"br":1},{"size":18,"text":" その上に着るものは外套 "},{"br":1},{"size":10,"text":"32 "},{"br":1},{"size":18,"text":"\n未だにチョッキていう奴いてビビったわ "},{"br":1},{"size":10,"text":"34 "},{"br":1},{"size":18,"text":"\n令和最新版はスカジャンとか言わんのか "},{"br":1},{"size":10,"text":"38 "},{"br":1