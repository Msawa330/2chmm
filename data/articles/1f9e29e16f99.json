{"id":"1f9e29e16f99","publishedAt":1795382551000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/a/8/a83ca514.png"}],[{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"\nカメラつよ…"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"🙌 "},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"href":"https://t.co/fpOlQnrmpg","text":"pic.twitter.com/fpOlQnrmpg"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"— ちいかわ💫アニメ火金 (@ngnchiikawa) "},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"href":"https://x.com/ngnchiikawa/status/2124495400262635700?ref_src=twsrc%5Etfw","text":"2026年11月22日"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\nやっちゃえッ"}],[{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\n>>2"},{"br":1},{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\n📸💥"}],[{"bold":true,"text":"\nバズーカだったんだ…"}],[{"bold":true,"text":"\nどういう発想してたらカメラがバズーカに進化するんだ…"}],[{"bold":true,"text":"\n>>7"},{"br":1},{"bold":true,"text":"\nバカでかいレンズのことはわりとバズーカって呼ぶんだ"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nハチワレのビーム出すやつでだいたい勝てる"}],[{"bold":true,"text":"\n>>8"},{"br":1},{"bold":true,"text":"\n割とこれを思い出し人多そう"}],[{"bold":true,"text":"\n>>8"},{"br":1},{"bold":true,"text":"\nセイレーンとかあの子もこれ直撃したら普通に死にそう"}],[{"bold":true,"text":"\n当て勘がいい…今日までの修行が活きてるな"}],[{"bold":true,"text":"\nまあ分かってたよね筆のノリから絶対準レギュラーとしての日常期間なんて設けられないって"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\nこの「敵」前も襲撃してこなかった？"}],[{"bold":true,"text":"\nハチワレのレンズからロケット弾出るバズーカカメラでだいたい勝てる"}],[{"bold":true,"text":"\n明らかに擬音に強さを感じるバズーカ"}],[{"bold":true,"text":"\nカメバズーカ…って事！？"}],[{"color":"rgb(240, 98, 2)","bold":true,"text":"\n心の底から怒ってないって言ってもなんか…怒りっぽくなってない？"}],[{"bold":true,"text":"\n>>15"},{"br":1},{"bold":true,"text":"\n怒ってないッ！"}],[{"bold":true,"text":"\n>>117"},{"br":1},{"bold":true,"text":"\nやっちゃえッ"}],[{"bold":true,"text":"\n>>117"},{"br":1},{"bold":true,"text":"\nハッ💥"}],[{"bold":true,"text":"\nこれ怪異討伐用によくね？と思ったらほんとに使い出しててダメだった"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nもーッこんな時にッッ"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"\nがもう忙しい時に出た害虫みたいな扱い"}],[{"bold":true,"text":"\n>>17"},{"br":1},{"bold":true,"text":"\nまあそれそのものじゃないかな…"}],[{"bold":true,"text":"\n弾数無限ならだいぶ強力だなこれ"}],[{"bold":true,"text":"\nバズーカみたいなカメラという表現はあるが本当にバズーカとなるとは"}],[{"bold":true,"text":"\n殺してないこれ"}],[{"bold":true,"text":"\n>>20"},{"br":1},{"bold":true,"text":"\n討伐してる奴らだぞ！"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\nこの武器うさぎの爆発棒より強いのでは？"}],[{"bold":true,"text":"\n>>22"},{"br":1},{"bold":true,"text":"\nアニメでこれの音凄かったからこのカメラも凄そうだ…"}],[{"bold":true,"text":"\nこのバズーカあったら力におぼれてキメラ化はしそうにない"}],[{"bold":true,"text":"\n破壊力高いな…"}],[{"bold":true,"text":"\nもうバズーカ使いこなしてる…"}],[{"color":"rgb(240, 98, 2)","bold":true,"text":"\n怒ワレは何のために何をしてそこに居るんだ…"}],[{"bold":true,"text":"\n>>29"},{"br":1},{"bold":true,"text":"\n😠"}],[{"bold":true,"text":"\nこういうイライラはあるんだなハチワレも"}],[{"bold":true,"text":"\nやっちゃえッで爆笑した"},{"br":1},{"bold":true,"text":"\nずるいよ"}],[{"bold":true,"text":"\nカメラ機能無くなってるのはもはや退化なのでは？"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nやっぱハチワレはカメラ買う前に扉付けろよ"}],[{"bold":true,"text":"\n最強の武器を手に入れてしまったな…"}],[{"bold":true,"text":"\nバズーカが存在する世界だから中には討伐でバズーカ使う奴とかいるのかな･･･"}],[{"bold":true,"text":"\n刺股でちくちくやってるのがアホらしくなるくらいの高性能"}],[{"bold":true,"text":"\n今更だけどこの家玄関扉すらないのヤバいな"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\nゴキブリまた来たくらいのノリ"}],[{"bold":true,"text":"\nカメラで遠距離攻撃もできるし本体にノーリスクの分身もいるし"},{"br":1},{"bold":true,"text":"\n「最強」なのだった"}]],"comments":["心の底からではなかったとしても、普段出さない怒りの感情が出やすくなってる？","赤ワレが怒らせるためにカメラ改造したと思った","心の底から怒ってなくても命のやりとりできるんだなパスタライ助"]}