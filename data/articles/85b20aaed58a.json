255)","text":">>120"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":" 車に住んで食料はまぁ自炊なりでどうにかすれば結構貯まりそう"}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>37"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":" とりあえず大げさに言っとけば面白いと思いこんでるやつおるよな"}],[{"bold":true,"color":"rgb(51, 51, 51)","text":"去年の時点でこうやぞ "},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/kinisoku/imgs/5/6/5600ea7d.jpg"},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/kinisoku/imgs/0/4/048833c7.jpg"}],[{"bold":true,"color":"rgb(0, 0, 102)","text":"日本人が東南アジアの大学に年収200万で "},{"br":1},{"bold":true,"color":"rgb(0, 0, 102)","text":" 雇ってやるいわれるようなもんやろ"}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>54"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":" もう東南アジアの物価は日本に近いんだ🥺"}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>70"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":" ベトナム行ったけど三分の一やったで"}],[{"bold":true,"color":"rgb(0, 0, 102)","text":"600万ってアメリカ人感覚だと200 万くらいか？"}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>62"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":" 450万くらいちゃうかさすがに"}],[{"bold":true,"color":"rgb(51, 102, 255)","text":">>153"},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":" それはない"}],[{"bold":true,"color":"rgb(204, 51, 51)","text":"ワイの給料より低くて草"}],[{"bold":true,"color":"rgb(51, 51, 51)","text":"マックバイト以下で草"}],[{"bold":true,"color":"rgb(51, 51, 51)","text":"どんだけ貧乏なの我が国"}],[{"bold":true,"color":"rgb(51, 51, 51)","text":"600万円とか向こうやと貧困層やん"}],[{"bold":true,"color":"rgb(51, 51, 51)","text":"もっと金出せばくるってのは先進国の考え方やと思うんよな "},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":" そもそももう脱落してるんだから違うことでそれなりに豊かになる戦略をとれよと"}],[{"bold":true,"color":"rgb(51, 51, 51)","text":"カリフォルニアのマックバイト時給3200円 "},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":" フルタイムだと６１２万円"}],[{"bold":true,"color":"rgb(51, 51, 51)","text":"うぅ～ん "},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)","text":" まず組織に単純に財務的余裕がないのか "},{"br":1},{"bold":true,"color":"rgb(51, 51, 51)"