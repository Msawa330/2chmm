{"id":"2dea3ac66e70","publishedAt":1793900406000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/a/5/a599b53b.jpg"}],[{"color":"rgb(52, 44, 222)","bold":true,"text":"🍦 "},{"color":"rgb(52, 44, 222)","bold":true,"href":"https://t.co/pDcibWoU1s","text":"pic.twitter.com/pDcibWoU1s"},{"br":1},{"color":"rgb(52, 44, 222)","bold":true,"text":"— ちいかわ💫アニメ火金 (@ngnchiikawa) "},{"color":"rgb(52, 44, 222)","bold":true,"href":"https://x.com/ngnchiikawa/status/2118332266174968192?ref_src=twsrc%5Etfw","text":"2026年11月5日"}],[{"color":"rgb(219, 0, 0)","size":28,"bold":true,"text":"\nえっ…誰…"},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/3/f/3fc4977e.jpg"}],[{"color":"rgb(240, 98, 2)","size":28,"bold":true,"text":"\nだれっ！？"}],[{"bold":true,"text":"\nえ！？！？！？"}],[{"bold":true,"text":"\n怖いって！！"}],[{"bold":true,"text":"\n誰ェ…ねぇ誰なの…？怖いよぉ！"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nいつもの4人組だな"}],[{"bold":true,"text":"\n日常回からヌルッと入ってくるのやめて"}],[{"bold":true,"text":"\nこれ続く話だな…"}],[{"bold":true,"text":"\n>>11"},{"br":1},{"bold":true,"text":"\nこれ単体で終わった方が怖くはある"}],[{"bold":true,"text":"\nパピコは湧かないのか"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\nドッペルゲンガー？"}],[{"bold":true,"text":"\nハチワレ亜種みたいなのがいる…"}],[{"bold":true,"text":"\nあ、あうっ…急に始まるのかっ…"}],[{"bold":true,"text":"\n自由すぎるだろ"}],[{"bold":true,"text":"\nなりたいやつがいるんじゃ…"}],[{"color":"rgb(240, 98, 2)","bold":true,"text":"\nソシャゲではよくあること"}],[{"bold":true,"text":"\nグリコもこれにはにっこり"}],[{"bold":true,"text":"\n何何"}],[{"bold":true,"text":"\nこれは6人いて足りなくなる奴か…？"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nモナ王"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"\nパスタライ助"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"\n大胆な暮らし"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"\n？？？"}],[{"bold":true,"text":"\nマジで何なんだよ！"}],[{"bold":true,"text":"\n誰じゃ…！？"}],[{"bold":true,"text":"\nスーパーハチワレ"}],[{"color":"rgb(181, 12, 205)","size":23,"bold":true,"text":"\n誰って…"},{"br":1},{"color":"rgb(181, 12, 205)","size":23,"bold":true,"text":"\n黄ワレはもともといただろう…？"}],[{"bold":true,"text":"\nドラクエの色替えモンスターみたいな…"}],[{"bold":true,"text":"\nナガノおかしいだろ！！！"}],[{"bold":true,"text":"\nなにごとも無かったかのように次回普通の話やってそう"}],[{"bold":true,"text":"\n気軽に呪具だしてくるじゃん"}],[{"color":"rgb(240, 98, 2)","bold":true,"text":"\n子供の頃こういうのよくあったよな…なんか懐かしい"}],[{"bold":true,"text":"\nいやいつもの4人じゃん何言ってんだこのスレ…？"}],[{"bold":true,"text":"\n新章始まってるだろ"}],[{"bold":true,"text":"\nもう一回もぎるとさらに増えるのかな"},{"br":1},{"bold":true,"text":"\n最終的に7人組に？"}],[{"bold":true,"text":"\n>>46"},{"br":1},{"bold":true,"text":"\nもぎった奴が増えるのかこの場でランダム発生なのかが問題だな…"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nなんかリプ欄は可愛いってきゃっきゃしてるのが多いけど"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"\n普通にホラーだよな？"}],[{"bold":true,"text":"\n感情が「輸出」されたか…"}],[{"bold":true,"text":"\nこれ絶対黄色以外のやつも出てくるだろ…赤とか"}],[{"bold":true,"text":"\nロングストロングパピコって何だよ…からの不意打ちホラーやめてくれ"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\nたぶん次もぎったらもう一人増えるよね"}],[{"bold":true,"text":"\n>>57"},{"br":1},{"bold":true,"text":"\nなるほどね…いやでもこれ吸ったらどうなるの…"}],[{"bold":true,"text":"\n>>84"},{"br":1},{"bold":true,"text":"\nまだ解除条件が分からないから慎重に行きたいな…"}],[{"bold":true,"text":"\n模倣型かぁ～？"}],[{"color":"rgb(240, 98, 2)","bold":true,"text":"\n緩急がすごい"}],[{"bold":true,"text":"\n馴染んでるけど怖いな"}],[{"bold":true,"text":"\n味方の可能性あるし"}],[{"bold":true,"text":"\n5人に増えれば均等に分けれるからね"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"✨新発売✨"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"『招福！ハチワレぬいぐるみS』"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"『招福！ハチワレマスコット』"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"🔸12月9日(金)発売"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"・ちいかわらんど"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"・ちいかわマーケット"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"・ちいかわ飯店"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"・ちいかわPOP UP STORE＠京都"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"🔸