{"id":"aa813a4038e7","publishedAt":1794950851000,"posts":[[{"size":19,"bold":true,"text":" 可哀想😳✋ "}],[{"size":19,"bold":true,"text":" そういう所が好きになれない所やわ "}],[{"size":19,"bold":true,"text":" 軍馬が必要なくなった今食用以外に使い道ないからな "}],[{"size":19,"bold":true,"text":" 乗ってよし賭けてよし食べてよしの人類の友や "}],[{"size":19,"bold":true,"text":" 乗馬クラブや牧場行けないんか？ "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>5"},{"br":1},{"size":19,"bold":true,"text":" 徒競馬はコスト掛かるから要らない "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>5"},{"br":1},{"size":19,"bold":true,"text":" 年間8000頭も産まれるから殺されずに済むのはごく僅かや "}],[{"size":19,"bold":true,"text":" 馬肉美味しいよな "}],[{"size":19,"bold":true,"text":" 馬刺し美味しい "}],[{"size":19,"bold":true,"text":" 馬が可哀想 "},{"br":1},{"size":19,"bold":true,"text":" 食うなら牛豚鶏だけにしろよ "}],[{"size":19,"bold":true,"text":" 天寿をまっとうする馬もちゃんといる "}],[{"size":19,"bold":true,"text":" こういうのでサラブレッドは筋肉質なので美味しくないから食べない！って言ってる層って何考えとるんやろな "},{"br":1},{"size":19,"bold":true,"text":" もっと筋肉まみれのばんえい競馬のばんばは公式で食ってるって明言してるのに "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>12"},{"br":1},{"size":19,"bold":true,"text":" それ自体はあってるで、サラブレッドも食べるのは競走馬になれなかったのだけや "},{"br":1},{"size":19,"bold":true,"text":" というか年齢行くと臭みとか出たり価値ないから "},{"br":1},{"size":19,"bold":true,"text":" ペットフードや馬油目的になる "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>15"},{"br":1},{"size":19,"bold":true,"text":" いやサラブレッドも競走馬登録されたあと勝てなくて無理ってわかったら登録消して熊本で飼育されて太らせて食われとるで "},{"br":1},{"size":19,"bold":true,"text":" それが現実やぞ "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>17"},{"br":1},{"size":19,"bold":true,"text":" 馴致段階で見切られたのが会津へ行くのはあるけど競争馬が熊本で肥育されたなんて聞いたことないわな "},{"br":1},{"size":19,"bold":true,"text":" 輸送費他肥育コストに割りに合わん上に値段が安いからね "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>15"},{"br":1},{"size":19,"bold":true,"text":" ラムも子ヤギのほうが絶品って言うもんな "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>19"},{"br":1},{"size":19,"bold":true,"text":" そもそもラムってのがコヤギで大きくなったらマトンや "},{"br":1},{"size":19,"bold":true,"text":