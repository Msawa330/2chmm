{"id":"944f65ec00a9","publishedAt":1794162722000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/diet2channel/imgs/a/c/ac90ba3f.png"}],[{"color":"#0000cd","size":16,"bold":true,"text":" ワロタ… "}],[{"size":16,"bold":true,"text":" 180あったわ "},{"br":1},{"size":16,"bold":true,"text":" 緊張しいだから無理 "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>2"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 俺も健康診断のときめっちゃ緊張するわ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" あと週3でカップ麺食ってるのがダメだな "}],[{"size":16,"bold":true,"text":" 下がそれなら上はヤバいな "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>3"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 上な "}],[{"size":16,"bold":true,"text":" 身長は？ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>6"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 171 "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>9"},{"br":1},{"size":16,"bold":true,"text":" 長身ならある程度高くても仕方ないと思ったけど "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>15"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 身長高いと血圧も高いのか "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>19"},{"br":1},{"color":"#ffa500","size":18,"bold":true,"text":" 体が大きい人は当然血液が循環するルートも長くなるからその分血圧は高くなる　 "},{"br":1},{"color":"#ffa500","size":18,"bold":true,"text":" これは太ってる人も同じ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>22"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" なるほろね "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 自宅でも高いようなら医者に相談してくださいとか怖す "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>24"},{"br":1},{"color":"#ffa500","size":18,"bold":true,"text":" 下が100超えたら問答無用で再検査になるはずだから来年は気をつけたほうがいいぞ "},{"br":1},{"color":"#ffa500","size":18,"bold":true,"text":" 食習慣改善して一食の塩分を2g前後に抑えるんだ "},{"br":1},{"color":"#ffa500","size":18,"bold":true,"text":" カップ麺はほぼ食えなくなるがな "}],[{"size":16,"bold":true,"text":" 下はいくつなの "},{"br":1},{"size":16,"bold":true,"text":" 下が90以下ならなんの問題もないよ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>10"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 96 "}],[{"size":16,"bold":true,"text":" 高血圧の基準が低くなってると思う "},{"br":1},{"size":16,"bold":true,"text":" 薬飲ませて儲けようって気満々じゃね？ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 最近寝付きが悪いのは血圧が関係してんのかね "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 血圧測るやつで自宅でもやってみて下さいとか言われたけど、そんなもんないだろ普通 "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>17"},{"br":1},{"color":"#008000","size":18,"bold":true,"text":" オムロンのやつ3000円くらいで買えるよ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>18"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" へえーそんなもんなんだ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 納豆と鯖缶毎日食ってるんだがな… "}],[{"size":16,"bold":true,"text":" デブか？ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>26"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 体重は60 "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 塩分控えるの難しそうだな… "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>32"},{"br":1},{"color":"#800080","size":18,"bold":true,"text":" 塩分を排出するためにカリウムたくさん摂るのもいいけど、これは腎臓にさらなる負担がかかる諸刃の剣 "},{"br":1},{"color":"#800080","size":18,"bold":true,"text":" もし腎臓が悪いなら塩分もカリウムも制限しなくちゃいけないからオススメできない "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>35"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 肝臓はたぶん悪くないけどどうだろ "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 酒好きだから "}],[{"size":16,"bold":true,"text":" 薬がいやなら胡麻麦茶飲もうぜｗｗｗ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>33"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" 効果あるんかね "},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":" リコピンとかは？ "}],[{"size":16,"bold":true,"text":" 俺も毎日納豆食ってる "}],[{"size":16,"bold":true,"text":" 1回目130でちょっと高いですね～　もう一度やってみますね～ "},{"br":1},{"size":16,"bold":true,"text":" とか言われてやったら162だった "},{"br":1},{"size":16,"bold":true,"text":" なんで一瞬でこんなに爆上げすんの？ "}],[{"size":16,"bold":true,"text":" 気をつけないと、血圧下げる薬飲んでも200叩き出すとか "},{"br":1},{"size":16,"bold":true,"text":" そんな風になっちゃうぞ "}],[{"color":"#dc143c","size":24,"bold":true,"text":" お酢飲め "},{"br":1},{"color":"#dc143c","size":24,"bold":true,"text":" 少し下がるぞ "},{"br":1},{"bold":true,"color":"rgb(255, 51, 102)","text":"▼アクセスの多い関連記事"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/63179628.html","color":"rgb(0, 102, 204)","text":"健康診断で血圧が160だったｗｗｗｗｗｗｗｗｗｗｗｗｗ"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/63115573.html","color":"rgb(0, 102, 204)","text":"【悲報】塩食いすぎたら高血圧ってエヴィデンスあるの？"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/62774071.html","color":"rgb(0, 102, 204)","text":"健康診断で血圧160を記録してもうたｗｗｗｗｗｗｗｗｗｗｗｗ"},{"br":1},{"color":"gray","text":"引用元:"},{"color":"gray","text":"http://viper.2ch.sc/test/read.cgi/news4vip/1606471714/"},{"br":1},{"text":"<url>"},{"text":"<title>"}]],"comments":["枕の高さを合わせよう","ブロッコリースプラウトを勧めたれて食べたら結構下がって驚いた。\n1日の中でも血圧はかなり変動するから一喜一憂しないように毎日定時で測るのが良い\n自分は朝起きた時が一番高い"]}