{"id":"520a6a602aee","publishedAt":1794918433000,"posts":[[{"size":19,"bold":true,"text":" 凄すぎて草 "},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/plusmicro26/imgs/0/4/046e1372.png"}],[{"size":19,"bold":true,"color":"mediumblue","text":">>2"},{"br":1},{"size":19,"bold":true,"text":" 5シーズンでOPS+171、ERA+151って改めて言われると相当バグな選手やな "},{"br":1},{"size":19,"bold":true,"text":" そら二度と現れないユニコーン扱いもされる "}],[{"size":19,"bold":true,"text":" プホルスも入るか "},{"br":1},{"size":19,"bold":true,"text":" さすがやな "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>3"},{"br":1},{"size":19,"bold":true,"text":" ホンマよな "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>3"},{"br":1},{"size":19,"bold":true,"text":" プーホールズな "}],[{"size":19,"bold":true,"text":" タイ・カッブの悪魔的な顔よ "}],[{"size":19,"bold":true,"text":" ベーブ・ルース "},{"br":1},{"size":19,"bold":true,"text":" ウィリー・メイズ "},{"br":1},{"size":19,"bold":true,"text":" ルー・ゲーリック "},{"br":1},{"size":19,"bold":true,"text":" テッド・ウィリアムズ "},{"br":1},{"size":19,"bold":true,"text":" ジョシュ・ギブソン "},{"br":1},{"size":19,"bold":true,"text":" タイ・カッブ "},{"br":1},{"size":19,"bold":true,"text":" ウォルター・ジョンソン "},{"br":1},{"size":19,"bold":true,"text":" ハンク・アーロン "},{"br":1},{"size":19,"bold":true,"text":" アルバート・プホルス "},{"br":1},{"size":19,"bold":true,"text":" 大谷翔平 "}],[{"size":19,"bold":true,"text":" プホルスよりはジャッジじゃね "},{"br":1},{"size":19,"bold":true,"text":" まだ実績不足なんか "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>7"},{"br":1},{"size":19,"bold":true,"text":" ジャッジがプホルスより偉大って言っとる奴はヤンキースファンにもおらんぞ流石に "}],[{"size":19,"bold":true,"text":" すげえな "},{"br":1},{"size":19,"bold":true,"text":" お前らこれも腐すんか？ "}],[{"size":19,"bold":true,"text":" お薬系の選手は流石に除外か "},{"br":1},{"size":19,"bold":true,"text":" マグワイアボンズAロッドもナチュラルだったら選出されたかもしれんのに "}],[{"size":19,"bold":true,"text":" ボンズは？ "}],[{"size":19,"bold":true,"text":" 因みに米スポーティングニュースは全米最優秀アスリート賞や各リーグのMVP、カムバック賞とかをアメリカで1番最初に表彰した1番歴史のあるスポーツ紙やね "}],[{"size":19,"bold":true,"text":" スポーツニュース 140人の偉大な選手 "},{"br":1},{"size":19,"bold":true,"text":" 内側の円 "},{"br":1},{"size":19,"bold":true,"text":" 大谷翔平は2021-25年の5シーズンで全会一致で4つのMVPを獲得し、その間にメジャー通算2番目に優れた打線(OPS+171)と最高の投手ライン(ERA+151)を擁した。 "},{"br":1},{"size":19,"bold":true,"text":" それらは他のすべての伝説が測定される基準である。ダイヤモンドに足を踏み入れた史上最高の存在。野球界を代表する選手たちの最後の部屋へ一歩足を踏み入れる。インナーサークルだ! "}],[{"size":19,"bold":true,"text":" これ打者しかおらんの？ "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>17"},{"br":1},{"size":19,"bold":true,"text":" ベーブルースと大谷がおる、ってのは冗談で基本的に打者>投手な扱いなのは世界共通やしな "}],[{"size":19,"bold":true,"text":" 打者ならジャッジの方が大谷より数段上なのでは？ "}],[{"size":19,"bold":true,"text":" ぶっちゃけアスリートとしてはゴールのその先に到達してるよな "}],[{"size":19,"bold":true,"text":" 米国人て他のやつが出来んことにチャレンジしてやり遂げた人間をヒーローとして異常に好むよな "}],[{"size":19,"bold":true,"text":" 大谷が入るのは当然としてもジャッジは過小評価されすぎてる気がする "}],[{"size":19,"bold":true,"color":"mediumblue","text":">>37"},{"br":1},{"size":19,"bold":true,"text":" 継続性があれば入ってたよ "},{"br":1},{"size":19,"bold":true,"text":" ジャッジってブレイクから今年で10年で色々あったけど "},{"br":1},{"size":19,"bold":true,"text":" プホルス全盛期は10年をずっと不調怪我なくやってたって考えるとヤバい "}],[{"size":19,"bold":true,"text":" 上原浩治さんも入らん？ "},{"br":1},{"size":19,"bold":true,"text":" あっこれ野手か "}],[{"size":19,"bold":true,"text":" 140年続いた分業制で二刀流やれたのはルースと大谷だけ "}],[{"size":19,"bold":true,"text":" 野球って投手のゲームなのに "}],[{"size":19,"bold":true,"text":" 投手版は "}],[{"size":19,"bold":true,"text":" 二刀流だからな単体なら大した事ない "}],[{"size":19,"bold":true,"text":" むしろ大谷と肩を並べる選手が9人もいるのかよ "}],[{"size":19,"bold":true,"text":" お薬勢壊滅で草 "}],[{"size":19,"bold":true,"text":" ジャッジって言ってしまえばめちゃくちゃ打ってるってだけだからな "},{"br":1},{"size":19,"bold":true,"text":" 大谷みたいな唯一無二性は無い "}],[{"size":19,"bold":true,"text":" 寧ろ３傑でも大谷は入る "}],[{"size":19,"bold":true,"text":" サイ・ヤングおらんやん "}],[{"size":19,"bold":true,"text":" 大谷はともかくプホルスに異論唱える人って晩年のプホルスしか知らんとかそういう感じなのかね "}]],"comments":[">>2(⊃＊⊂)\n‖\n🍮ﾌﾞﾘｯ",">>1脅迫|罪ハッ|カークズ"]}