{"id":"282031ef2f62","publishedAt":1794603655000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/nikoniko_style/imgs/c/3/c309a04e.jpg"},{"br":1},{"size":10,"text":"【引用画像】出典：『ドラゴンクエスト5』"},{"br":1},{"size":10,"text":"1 "},{"size":10,"text":"2026/11/13(金)"},{"br":1},{"size":18,"text":"\nドラクエ5の唯一の欠点"},{"br":1},{"size":18,"text":"\nヘンリーがうざい "},{"br":1},{"size":18,"text":" ビアンカに魅力がない "},{"br":1},{"size":10,"text":"18 "},{"br":1},{"size":18,"text":"\nむしろヘンリーちゃんと仲間になれや "},{"br":1},{"size":10,"text":"3 "},{"br":1},{"size":18,"text":"\n結婚しないと言う選択肢が無い "},{"br":1},{"size":10,"text":"2 "},{"br":1},{"size":18,"text":"\nマリアを嫁に選べない "},{"br":1},{"size":10,"text":"8 "},{"br":1},{"size":18,"text":"\nルドマンと結婚できない "},{"br":1},{"size":10,"text":"11 "},{"br":1},{"size":18,"text":"\nゲレゲレが弱い "},{"br":1},{"size":18,"text":" ピエールだけて何とかなってしまう "},{"br":1},{"size":10,"text":"12 "},{"br":1},{"size":18,"text":"\n嫁がどっちも可愛く無い "},{"br":1},{"size":10,"text":"13 "},{"br":1},{"size":18,"text":"\n勇者がこども "},{"br":1},{"size":10,"text":"14 "},{"br":1},{"size":18,"text":"\n石化した両親探す息子・娘・サンチョのパーティでの"},{"br":1},{"size":18,"text":"冒険パートがない "},{"br":1},{"size":10,"text":"21 "},{"br":1},{"size":18,"text":"\n娘が息子にコンプレックス抱えてるけど"},{"br":1},{"size":18,"text":"イオナズン使える方が偉い "},{"br":1},{"size":10,"text":"24 "},{"br":1},{"size":18,"text":"\n奴隷生活をもっと克明に描くべきやったわ "},{"br":1},{"size":10,"text":"25 "},{"br":1},{"size":18,"text":"\n主人公を女にできない "},{"br":1},{"size":10,"text":"23 "},{"br":1},{"size":24,"color":"#CC3333","text":"主人公の武器が杖 "},{"br":1},{"size":10,"text":"\n引用元\n"},{"size":10,"text":"https://tomcat.2ch.sc/test/read.cgi/livegalileo/1794495874/"}]],"comments":[]}