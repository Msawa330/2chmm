{"id":"750809712737","publishedAt":1794114637000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/itsoku/imgs/8/5/85564940.png"}],[{"color":"#0000cd","size":18,"bold":true,"text":" ぼく「あ、初めてで…」 "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 職員「え？w初めて？ww」 "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ぼく「あ、はい…」 "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 職員「初めてって今更ですか？wなんで作らなかったんですか？w」 "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ぼく「あ…・ぁ…」 "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 職員「じゃあまず～w」 "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ぼく「やっぱいいです」(超早口) "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" (´；ω；`) "}],[{"size":18,"bold":true,"text":" なんで作らないの？ "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>2"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" なんで新しく作っちゃ駄目なの？(´；ω；`) "}],[{"size":18,"bold":true,"text":" 誰だって初めては怖いよでも職員は手慣れてるから大丈夫だよ全部任せちゃえばいい "},{"br":1},{"size":18,"bold":true,"text":" 天井のシミ数えてる間に終わる "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>3"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 勝手に何か契約させられそう(´；ω；`) "}],[{"size":18,"bold":true,"text":" まだ写真機で申し込めるのかな "}],[{"size":18,"bold":true,"text":" そんなこと言われたの？ "}],[{"size":18,"bold":true,"text":" マジレスするとマイナンバーカードの作り方は役所に書類を送付後、役所で手続きだからその時点では引き換えせんだろ "}],[{"size":18,"bold":true,"text":" 役所より先に "},{"br":1},{"size":18,"bold":true,"text":" 精神病院行け "}],[{"size":18,"bold":true,"text":" なんで今まで作らなかったの？ "}],[{"size":18,"bold":true,"text":" 申請するのに役所行く必要ってないんだけどな "},{"br":1},{"size":18,"bold":true,"text":" 役所に行くのは受け取ってパスワード決めるとき "}],[{"color":"#0000cd","size":18,"bold":true,"text":" ぼくが住んでる市では役所に行くと作ってくれます(´；ω；`) "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" くれるのは1か月後ですが(´；ω；`) "}],[{"color":"#0000cd","size":18,"bold":true,"text":" みなさん好き勝手言ってますがマイナンバーカード持ってるんですか？(´；ω；`) "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 持ってる人だけ文句言いなさい(´；ω；`) "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>15"},{"br":1},{"size":18,"bold":true,"text":" コロナ前から持ってるぞオッサン "}],[{"size":18,"bold":true,"text":" 苦情入れた？ "}],[{"color":"#0000cd","size":18,"bold":true,"text":" 苦情は入れてません(´；ω；`) "}],[{"size":18,"bold":true,"text":" 役所に「マイナ保険証の紐付け解約」に行ったらあまりにもあっさり手続きが終わったわ "},{"br":1},{"size":18,"bold":true,"text":" 受付証明書すらもらえなくて、これ本当に解約できるんか？と疑ったぐらい "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>18"},{"br":1},{"size":18,"bold":true,"text":" 紐付けを解除しても、これまでのレセプト（診療報酬明細書）などの医療情報やマイナンバー自体の登録が消去されるわけではありません。 "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>48"},{"br":1},{"size":18,"bold":true,"text":" あーでもね、マイナカード発行後からマイ保解約まで1回も病院行ってないんよ "},{"br":1},{"size":18,"bold":true,"text":" 税金の返還（マイナポイント）を受けつつ日本最小限の被害だと思うの "}],[{"size":18,"bold":true,"text":" 作ろう作ろうと思ってるけど中々重い腰が上がらない "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>21"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 持ってない人はレスしないでください(´；ω；`) "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>24"},{"br":1},{"size":18,"bold":true,"text":" なんで "}],[{"size":18,"bold":true,"text":" 今は時期が悪い "}],[{"size":18,"bold":true,"text":" そんな職員はいない "}],[{"size":18,"bold":true,"text":" そんなこと言わんだろあいつら感情無くしたマシーンだよ "}],[{"color":"#0000cd","size":18,"bold":true,"text":" どうして… "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ぼくマイナンバーカード欲しいだけだったのに(´；ω；`) "}],[{"size":18,"bold":true,"text":" 普通に作りゃいいのになんで帰ってきたのさ？ "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>30"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" お前は何もわかってない(´；ω；`) "}],[{"size":18,"bold":true,"text":" 別な職員に頼もう "}],[{"size":18,"bold":true,"text":" 認知されると行きたくなくなったり煽られたと思うと行きたくなくるとかほんとめんどくさいよな "}],[{"color":"#0000cd","size":18,"bold":true,"text":" もうぼくは一生マイナンバーカード作れない(´；ω；`) "}],[{"size":18,"bold":true,"text":" マイナンバーカード作るのでこんなに難儀してたら日常生活送れねえだろ "},{"br":1},{"size":18,"bold":true,"text":" 大変だなお前・・・ "}],[{"size":18,"bold":true,"text":" マイナンバーカードが必要だから作りに行ったんじゃないの？ "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>43"},{"br":1},{"size":18,"bold":true,"text":" 必要ないのにマイナポイントに釣られて作った国民が大半だけどな "}],[{"color":"#0000cd","size":18,"bold":true,"text":" 免許証ないから本人確認用に欲しいだけなのに(´；ω；`) "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>44"},{"br":1},{"size":18,"bold":true,"text":" なら免許取れば？ "}],[{"size":18,"bold":true,"text":" パスポートも本人確認書類としては2軍に落ちたもんな "}],[{"color":"#ff0000","size":18,"bold":true,"text":" 未だに作ってないのは陰謀論者だろうから "},{"br":1},{"color":"#ff0000","size":18,"bold":true,"text":" ヤベーやつだと思われるだろうね "}],[{"size":18,"bold":true,"text":" 面倒で作ってない "},{"br":1},{"size":18,"bold":true,"text":" 役所が勝手に送ってこいよ "}],[{"size":18,"bold":true,"text":" ポイントで釣ってるの本当にゴミだったよな "},{"br":1},{"size":18,"bold":true,"text":" 結局自分もあの後に外堀埋められて降参する形でつくったけど "},{"br":1},{"text":"元スレ: "},{"text":"https://mi.5ch.io/test/read.cgi/news4vip/1793609047/"}]],"comments":["サナカルトの果実","失礼な態度も黒ギャルだったら許せる","45みたいな返しをしちゃうやつほんとださい"]}