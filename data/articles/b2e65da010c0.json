{"id":"b2e65da010c0","publishedAt":1795301041000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/diet2channel/imgs/3/b/3b71ad4d.png"}],[{"color":"#0000cd","size":16,"bold":true,"text":" 地獄すぎる "}],[{"color":"#008000","size":16,"bold":true,"text":" そこまで寒くなかった "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>2"},{"br":1},{"size":16,"bold":true,"text":" いや極寒だったぞ "},{"br":1},{"size":16,"bold":true,"text":" ちょうど江戸時代は寒さのピークが1番酷い時期 "},{"br":1},{"size":16,"bold":true,"text":" 200年周期くらいで変わるんだよ "}],[{"color":"#0066ff","size":16,"bold":true,"text":" でも熱燗あり　鍋あり　銭湯あり　痩せ我慢あり　粋あり "},{"br":1},{"color":"#0066ff","size":16,"bold":true,"text":" だぜ？ "}],[{"size":16,"bold":true,"text":" どうやって寝てたの "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>5"},{"br":1},{"size":16,"bold":true,"text":" 親子でくっついて布団にくるまって寝てた "},{"br":1},{"size":16,"bold":true,"text":" じゃないと家ん中隙間風だのなんだので寒くてたまらんと思う "}],[{"size":16,"bold":true,"text":" 囲炉裏あり "}],[{"size":16,"bold":true,"text":" つまり徳川家の将軍より現代のニートの方が贅沢な暮らしをしてる訳だな "}],[{"color":"#008000","size":16,"bold":true,"text":" 根性あり！！！！！！！！！！！！！！ "}],[{"color":"#ff3366","size":16,"bold":true,"text":" マジレスするとあたたかい布団さえあれば余裕 "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>9"},{"br":1},{"size":16,"bold":true,"text":" 暖かい布団は無い😭 "},{"br":1},{"size":16,"bold":true,"text":" 庶民に敷布団掛け布団が広まるのは江戸時代後期 "},{"br":1},{"size":16,"bold":true,"text":" それまでは筵に服かけて寝ていた "}],[{"size":16,"bold":true,"text":" 隅田川がすべて凍るほど気温が下がったからな "}],[{"size":16,"bold":true,"text":" 洗濯炊事やってたかーちゃんたちの手でゴリゴリの手こきされてたんかな "}],[{"size":16,"bold":true,"text":" 江戸っ子魂で頑張ったんだろ "}],[{"size":16,"bold":true,"text":" なんで靴作ろうって発想なかったの "}],[{"color":"#008000","size":16,"bold":true,"text":" 夏の冷房なしの方がやばい "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>14"},{"br":1},{"size":16,"bold":true,"text":" 夏は大丈夫だ "},{"br":1},{"size":16,"bold":true,"text":" 昭和ですら夏なんて冷房なくても過ごせた "},{"br":1},{"size":16,"bold":true,"text":" 今ほど暑くなかった "},{"br":1},{"size":16,"bold":true,"text":" おまけに日本家屋はけっこう風が通る "},{"br":1},{"size":16,"bold":true,"text":" 冬は最悪だが夏は涼しい "}],[{"size":16,"bold":true,"text":" しかもあいつら草鞋で雪の中歩くのが格好いいと思ってるヤンキーだからな "}],[{"size":16,"bold":true,"text":" ソリコミ半端ないしな "}],[{"size":16,"bold":true,"text":" 寒さよりも食い物やばいって "},{"br":1},{"size":16,"bold":true,"text":" コンビニとかスーパーないんだぞ "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>19"},{"br":1},{"size":16,"bold":true,"text":" 江戸の町中なら深夜じゃなきゃ屋台はうじゃうじゃいたらしいけどな "}],[{"size":16,"bold":true,"text":" あっても長屋では火鉢くらいがせいぜいかヤカンでお湯が沸かせれば御の字 "}],[{"color":"#ff3366","size":16,"bold":true,"text":" クソ寒いからってこたつに潜ってたり火鉢の前から動かなかったりすると怠け者とされてたしな "},{"br":1},{"bold":true,"color":"rgb(255, 51, 102)","text":"▼アクセスの多い関連記事"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://aaa/","color":"rgb(0, 102, 204)","text":"aaaaaaaaaaaaaaaaaaaaaaaa"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://aaa/","color":"rgb(0, 102, 204)","text":"aaaaaaaaaaaaaaaaaaaaaaaa"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://aaa/","color":"rgb(0, 102, 204)","text":"aaaaaaaaaaaaaaaaaaaaaaaa"},{"br":1},{"color":"gray","text":"引用元:"},{"color":"gray","text":"https://mi.5ch.io/test/read.cgi/news4vip/1794566478/"},{"br":1},{"text":"<url>"},{"text":"<title>"}]],"comments":[]}