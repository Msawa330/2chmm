{"id":"ec47eb67c888","publishedAt":1793958652000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/danseisama/imgs/b/e/be1a1351.png"},{"br":1},{"color":"gray","size":12,"text":"編集元: 株と仮想通貨で7000万稼いだが仕事で上司がうざくて俺は会社辞めても困らねえぞって強気に出てしまった"}],[{"color":"#2a128a","size":16,"bold":true,"text":"\n 7000万で老後どうにかなる？ "}],[{"size":16,"bold":true,"text":"\n いくつ？ "}],[{"color":"#2a128a","size":16,"bold":true,"text":"\n もうすぐ40 "}],[{"size":16,"bold":true,"text":"\n 7000万儲ける奴がそんなことすら考えられへんわけないやろ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>3"},{"br":1},{"color":"#2a128a","size":16,"bold":true,"text":" 金を持つと気が強くなる "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>6"},{"br":1},{"size":16,"bold":true,"text":" 田舎ならいけると思うが若いな "}],[{"size":16,"bold":true,"text":"\n 今からリッチなホームレスなれば余裕やろ "}],[{"size":16,"bold":true,"text":"\n もっと大胆に行こう "}],[{"size":16,"bold":true,"text":"\n どうにかなる "},{"br":1},{"size":16,"bold":true,"text":" でも仕事はやったほうがええで "}],[{"size":16,"bold":true,"text":"\n 半分ここで寄付しても余裕 "}],[{"color":"#2a128a","size":16,"bold":true,"text":"\n 農家でもはじめようか考えるけど500万くらいでどうにかならんか？ "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>11"},{"br":1},{"size":16,"bold":true,"text":" 業種にもよるけど農協相談いったら3000万は用意しろって言われるぞ "},{"br":1},{"size":16,"bold":true,"text":" 7000万なんてすぐ溶ける "}],[{"size":16,"bold":true,"text":"\n 年間400万で生活するとして17年分か。 "},{"br":1},{"size":16,"bold":true,"text":" もうちょっと仕事頑張るかしっかり運用継続した方がええな。 "}],[{"size":16,"bold":true,"text":"\n 7000万円を年4パーで運用したら年280万 "},{"br":1},{"size":16,"bold":true,"text":" 大丈夫やろ "}],[{"color":"#2a128a","size":16,"bold":true,"text":"\n やっぱ足りんか？ "}],[{"size":16,"bold":true,"text":"\n 仕事中に部下に真顔でそんな台詞吐かれた上司の身にもなれよ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>23"},{"br":1},{"color":"#2a128a","size":16,"bold":true,"text":" あいつが悪いわ "},{"br":1},{"color":"#2a128a","size":16,"bold":true,"text":" 本気で切れた "}],[{"size":16,"bold":true,"text":"\n わいなら7000万なら即リタイアや "},{"br":1},{"size":16,"bold":true,"text":" 7～8％は余裕で回せる "},{"br":1},{"size":16,"bold":true,"text":" 回せるがわいには元手がない金くれ "}],[{"size":16,"bold":true,"text":"\n 内訳見ないとなんとも "},{"br":1},{"size":16,"bold":true,"text":" てかそれ利確前の話やし税金取られたら生きてけねーよ "}],[{"size":16,"bold":true,"text":"\n どうせ利確してへんやろ "},{"br":1},{"size":16,"bold":true,"text":" 半分国に取られるで "}],[{"color":"#2a128a","size":16,"bold":true,"text":"\n 半分とか嘘やろ？ "}],[{"size":16,"bold":true,"text":"\n 7000万稼いだら半分以上持ってかれるんか？夢無いな "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>36"},{"br":1},{"size":16,"bold":true,"text":" 特に仮想通貨は利確だけじゃなくて持ってるコインで別のコイン買っても税金発生する "},{"br":1},{"size":16,"bold":true,"text":" これ知らずに無自覚な脱税繰り返してる奴多い "},{"br":1},{"size":16,"bold":true,"text":" 税務調査の周期で取引所に監査入ったら終わりやで "},{"br":1},{"size":16,"bold":true,"text":" 雑所得特有の激ヤバ税金に更に追徴金上乗せで普通に人生終わる "}],[{"size":16,"bold":true,"text":"\n 仮想通貨で7000万稼いだ俺だが会社でうざい上司にうんざりし退職～やっぱり帰ってきてほしい？今更もう遅い～ "}],[{"size":16,"bold":true,"text":"\n セミリタイヤの目安は30歳1億40歳6000万て聞いた "}],[{"size":16,"bold":true,"text":"\n 株始めて思ったがこれ富裕層ほどヌルゲーじゃん "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>34"},{"br":1},{"size":16,"bold":true,"text":" 数千万円儲けても数億儲けても20％って実は凄いよな "}],[{"size":16,"bold":true,"text":"\n 米農家は儲からないからやめとけ "}],[{"size":16,"bold":true,"text":"\n 7000万の貯金抱えながらコンビニでのんびりバイトすればええやん "}],[{"size":16,"bold":true,"text":"\n どうせほとんど仮想通貨だろ "},{"br":1},{"size":16,"bold":true,"text":" 半分取られろ半分 "}],[{"size":16,"bold":true,"text":"\n ギリギリ逃げきれるな "}],[{"size":16,"bold":true,"text":"\n その7000万も利確したら4000万くらいになってそう "}],[{"size":16,"bold":true,"text":"\n 品性は買えないよな "}],[{"size":16,"bold":true,"text":"\n 戸建てもってて住居の固定費が固定資産税だけやったら "},{"br":1},{"size":16,"bold":true,"text":" 年150マン×死ぬまでの年数あれば隠居できるで "}],[{"size":16,"bold":true,"text":"\n 給料プラスビットコインでの所得で累進課税適用されるぞ "}],[{"size":16,"bold":true,"text":"\n そもそも貯金100万程度あれば仕事なんて辞めても困らへんわ "},{"br":1},{"size":16,"bold":true,"text":" そこでしか働けないような無能以外どこも人手不足やからすぐ再就職できる "}],[{"size":16,"bold":true,"text":"\n こんなとこで株やビットコインの話が "},{"br":1},{"size":16,"bold":true,"text":" 天井か・・・ "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>50"},{"br":1},{"size":16,"bold":true,"text":" 昼のワイドショーですらやってるで "},{"br":1},{"size":16,"bold":true,"text":" むしろここからや "},{"br":1},{"size":16,"bold":true,"text":" 無知な大衆が本格的に金突っ込み始める "},{"br":1},{"size":16,"bold":true,"text":" 仮想通貨離婚とか出てくるんちゃうか "}],[{"size":16,"bold":true,"text":"\n 40歳で草 "},{"br":1},{"size":16,"bold":true,"text":" おっさんが金持ってても老いるだけなのにしょうがないやろ "}]],"comments":[]}