{"id":"9885a6cbc933","publishedAt":1794244196000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/itsoku/imgs/7/4/74294453.png"}],[{"color":"#0000cd","size":18,"bold":true,"text":" ずっと調べてて最近はだるいぜい "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ポケカまだやれます "}],[{"color":"#0000cd","size":18,"bold":true,"text":" 億万長者は確定した "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" あとはどれだけ億を増やせるか "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" とりあえず今の資金がないから投機しないと "}],[{"color":"#0000cd","size":18,"bold":true,"text":" キオクシアしょぼすぎておもろい "}],[{"size":18,"bold":true,"text":" 可哀想なので1レス(´・ω・) "}],[{"color":"#0000cd","size":18,"bold":true,"text":" 情報めっちゃあるけどばらしたくないからレス付かないのは仕方ない "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ポケカ以外もたくさんある "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>5"},{"br":1},{"size":18,"bold":true,"text":" ロルカナはやめとけ "}],[{"color":"#0000cd","size":18,"bold":true,"text":" ポケカ投資すらしてないのは未来見えてなさ過ぎる "}],[{"size":18,"bold":true,"text":" 秋葉原と横浜拠点に活動してたわ(´・ω・)何店舗も回りまくった "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>8"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 今はやってないのか？ "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 秋葉は高くてモダンカード買いたくないな "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" レトロなら秋葉にも頼らないといけないけど、秋葉廃れてきてる "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>12"},{"br":1},{"size":18,"bold":true,"text":" 廃れてきててもやっぱ広さと数がダンチだからな(´・ω・) "},{"br":1},{"size":18,"bold":true,"text":" 秋葉原に頼らなきゃ結構ムズいぞ "}],[{"color":"#0000cd","size":18,"bold":true,"text":" ロルカナは日本のIPじゃないから日本語版買うのはセンスないわな "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ロルカナ投資界隈あほばっかやわ "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" デジモンとかコナンもあほ "}],[{"size":18,"bold":true,"text":" 投機するという言い方でニートガチ感あるな "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>10"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 今年から投資始めようとしたらカードが一番上がるって分かったから、株の知識はない "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>15"},{"br":1},{"size":18,"bold":true,"text":" だから今の内に集めとくんだよ(´・ω・) "},{"br":1},{"size":18,"bold":true,"text":" 価値が上がってくるから寝かせとかなきゃ "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>17"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" そうだけど、コナンが海外で人気ないから他の物に賭けたい "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 日本で人気な奴はすぐ下がるから投機 "}],[{"size":18,"bold":true,"text":" 今、店で扱われてるカード全部触ってきたけどまだコナンはあり寄りだぞ(´・ω・) "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>11"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 女人気のIPはまだ早いよ "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 女コレクターが参戦してくるのはコレクティブ投資が一般化して市民権得た後 "}],[{"size":18,"bold":true,"text":" 俺子供や次女のアーケードガードも触ってたからな(´・ω・) "},{"br":1},{"size":18,"bold":true,"text":" 鬼滅の初動は酷かった "},{"br":1},{"size":18,"bold":true,"text":" 今もだろうけど "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>13"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 鬼滅のあれはクオリティーめっちゃ高いからいつか化けるよ "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" バトルスラッシュはロケテ版だけやたら上がったな "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ロケテ版の絵はサービス後と違うから特別だね "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>19"},{"br":1},{"size":18,"bold":true,"text":" ロケテのやつさ "},{"br":1},{"size":18,"bold":true,"text":" 絵柄一緒で1部だけ違う奴じゃん "},{"br":1},{"size":18,"bold":true,"text":" ネットでロケテを勘違いしてる出品してるやつ漁ったわ(´・ω・)笑 "},{"br":1},{"size":18,"bold":true,"text":" 鬼滅は煉獄さん出ても上がってないから危ういと思うぜ "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>20"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" あー鬼滅は今キッズ向けだからロケテ版分からずに出されんのか？ "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" それなかなか儲かるじゃんすごいな "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 鬼滅は令和世代の物だからまだ先やな "}],[{"size":18,"bold":true,"text":" プロモ集めるのがかなりしんどい(´・ω・) "},{"br":1},{"size":18,"bold":true,"text":" 数集めたり体験版プレイで貰えるプロモがまぁ高いのなんの "}],[{"size":18,"bold":true,"text":" まぁルーキーはワンピ、デュエマ、ポケカ、遊戯王、ドラゴボ、ガンダムぐらいじゃねかな(´・ω・) "},{"br":1},{"size":18,"bold":true,"text":" マジギャザはやめとけ(´・ω・)✊ "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>24"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ああルーキー買ってんだ "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ポケカワンピドラゴボはもうきついけどガンダムはええな "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 遊戯王はバンダイ版しか興味ない "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" マンガスタイルのカラシク13000→50000に伸びて原作イラストへの信頼感すごいわ "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" デュエマは触ったことない "}],[{"color":"#0000cd","size":18,"bold":true,"text":" 俺も関東住みだけど田舎みたいにレア物安く買えないからフリマで買うこと増えたな "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ウエハースはまだまだ先かな "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 歴史浅いからレトロになってない "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 一番最初のウエハースアニメカード2006年のエヴァじゃなかったっけ "}],[{"size":18,"bold":true,"text":" 代物は言わないが "},{"br":1},{"size":18,"bold":true,"text":" 今ウエハースのboxが手元にある(´・ω・)これお菓子全部食わなきゃいけないのがくっそダルい "}],[{"size":18,"bold":true,"text":" あと今は野良で探しても小学生以下中学生以下のみ購入可能って所がちらほらあるから足で探してもかなり厳しいよ(´・ω・)争奪戦になってるし "}],[{"color":"#0000cd","size":18,"bold":true,"text":" ウエハースやったことないからお菓子食い放題興味あったけど、ありすぎるとだるそうだなw "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ウエハースも子供限定になってるんだ "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 新品転売は規制されるから先ないねぇ "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" 中古に限る "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ドラゴボのイタジャガは質高くて興味ある "}],[{"size":18,"bold":true,"text":" イタジャガはドラゴボとガンダムぐらいしか人気ないぞ "}],[{"color":"#0000cd","size":18,"bold":true,"text":" イタジャガは長期で上がりそう "},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":" ガンダムはがちで宝の山 "},{"br":1},{"text":"元スレ: "},{"text":"https://mi.5ch.io/test/read.cgi/news4vip/1793916423/"}]],"comments":["アホやん","何","働け"]}