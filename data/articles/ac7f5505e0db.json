{"id":"ac7f5505e0db","publishedAt":1794031837000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/itsoku/imgs/0/1/01990c70.png"}],[{"color":"#0000cd","size":18,"bold":true,"text":" 他に適任いる？？ "}],[{"color":"#ff0000","size":18,"bold":true,"text":" 一年前「石破辞めろって言うけどじゃあ誰ならいいの？」 "}],[{"size":18,"bold":true,"text":" いっかいオガジュンにさせてみようや"},{"br":1},{"size":18,"bold":true,"text":"鳩山みたいな感じに愛されると思うで "}],[{"size":18,"bold":true,"text":" 高市じゃなきゃ誰でもいいってずっと言ってるんだが "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>6"},{"br":1},{"size":18,"bold":true,"text":"それ石破の時も岸田の時も菅の時も安部の時も言ってたやん "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>10"},{"br":1},{"size":18,"bold":true,"text":"ワイは岸田がいいの "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>13"},{"br":1},{"size":18,"bold":true,"text":"あいつ外交は神やな "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>6"},{"br":1},{"size":18,"bold":true,"text":"それ誰がなった時でも聞くけどさー"},{"br":1},{"size":18,"bold":true,"text":"現状コレやん "}],[{"color":"#0000cd","size":18,"bold":true,"text":" 党首討論からもG7からも逃げちゃうんだから皮肉とかじゃなく普通に代議士向いてない "}],[{"size":18,"bold":true,"text":" とりあえず岸田にしておけば外交で恥をかくことはあまりないだろう "}],[{"size":18,"bold":true,"text":" 岸田降ろしはガチで納得してない "}],[{"size":18,"bold":true,"text":" 岸田文雄はなんで下ろされたんだっけ？ "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>16"},{"br":1},{"size":18,"bold":true,"text":"増税メガネとか言われてた"},{"br":1},{"size":18,"bold":true,"text":"増税してないのに "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>16"},{"br":1},{"size":18,"bold":true,"text":"裏金議員処分して麻生派安倍派に嫌われたから "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>19"},{"br":1},{"size":18,"bold":true,"text":"高市が裏金議員とか公職選挙法違反疑惑議員使ってるのを見るとこの一手はやばいな "}],[{"color":"#ff0000","size":18,"bold":true,"text":" ノイジーマイノリティがどう言おうとも支持率50%以上が継続"},{"br":1},{"color":"#ff0000","size":18,"bold":true,"text":"若年層は相変わらず支持率7割超えや "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>18"},{"br":1},{"size":18,"bold":true,"text":"せやな "}],[{"size":18,"bold":true,"text":" 文春は中道激推ししてたし中道で良かったやろ "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>25"},{"br":1},{"size":18,"bold":true,"text":"中道なんてもうないぞ "}],[{"color":"#0000cd","size":18,"bold":true,"text":" 岸田石破の時は自民に入れてたけど高市である限りは最大野党に入れるぞワイは "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>40"},{"br":1},{"size":18,"bold":true,"text":"今の最大野党どこや "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>40"},{"br":1},{"size":18,"bold":true,"text":"中道と立憲が合流しないことになったから次たぶん立憲がくるとおもうわ "}],[{"size":18,"bold":true,"text":" そら神谷やろ "}],[{"size":18,"bold":true,"text":" 林どう？ "}],[{"size":18,"bold":true,"text":" 進次郎がいるだろ "}],[{"color":"#ff0000","size":18,"bold":true,"text":" 林・すんずろー・高市・あと誰か一人"},{"br":1},{"color":"#ff0000","size":18,"bold":true,"text":"って感じだったろ"},{"br":1},{"color":"#ff0000","size":18,"bold":true,"text":"あの中では林が一番まともだと思ってた"},{"br":1},{"color":"#ff0000","size":18,"bold":true,"text":"進次郎と高市は論外 "}],[{"size":18,"bold":true,"text":" 茂木か小野田かな "}],[{"size":18,"bold":true,"text":" 玉木雄一郎しかない "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>127"},{"br":1},{"size":18,"bold":true,"text":"ウンザリ"},{"br":1},{"size":18,"bold":true,"text":"優柔不断"},{"br":1},{"size":18,"bold":true,"text":"考えて考えて考え抜いて動かない "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>130"},{"br":1},{"size":18,"bold":true,"text":"優柔不断って何を持っていってるんや？"},{"br":1},{"size":18,"bold":true,"text":"お前はずっと国民民主党をウォッチしてきたが、徹頭徹尾言ってることはずっと変わらなかったけど "}],[{"size":18,"bold":true,"text":" 玉木は元官僚で国民民主の前身が未来の党っていう自民小池が作った党だし絶対自民の別動隊だろ "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>157"},{"br":1},{"size":18,"bold":true,"text":"国民が求めてるのは癒着や不正がない自民党じゃないの？"},{"br":1},{"size":18,"bold":true,"text":"少なくともわいは癒着や不正がない自民党を求めてるから自民党に最も近くて野党の国民民主党をおしてるけど "}],[{"color":"#0000cd","size":18,"bold":true,"text":" 次の総理「よろしく！」"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":"国民「辞めろー」"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":"次の総理「辞めるわ」"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":"次の次の総理「よろしく！」"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":"国民「辞めろー」"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":"以下エンドレス "}],[{"size":18,"bold":true,"text":" 外交ちゃんとできる人ならええわ "}],[{"size":18,"bold":true,"text":" 普通に林芳正でええやん"},{"br":1},{"size":18,"bold":true,"text":"ネトウヨの評判が悪い時点で信用できる "}],[{"size":18,"bold":true,"text":" 最近のウヨは政治利用されて情けないな"},{"br":1},{"size":18,"bold":true,"text":"高市も高笑いしてるわ "}],[{"size":18,"bold":true,"text":" 林芳正あたりに頑張ってもらおう"},{"br":1},{"size":18,"bold":true,"text":"ぶっちゃけ岸田が一番いいんだけどな"},{"br":1},{"size":18,"bold":true,"text":"この複雑怪奇な国際情勢を乗り切るには外交の岸田が適任 "}],[{"color":"#ff0000","size":18,"bold":true,"text":" 増税してないのに増税メガネという渾名を付けられた岸田 "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>167"},{"br":1},{"size":18,"bold":true,"text":"無能扱いなの納得いかん "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>167"},{"br":1},{"size":18,"bold":true,"text":"じゃあ移民眼鏡って呼ぶ？ "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>169"},{"br":1},{"size":18,"bold":true,"text":"それは早苗でええんやないか "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>169"},{"br":1},{"size":18,"bold":true,"text":"高市早苗が移民対策何かしてるんか？ "}],[{"color":"#0000cd","size":18,"bold":true,"text":" 進次郎でも良かった"},{"br":1},{"color":"#0000cd","size":18,"bold":true,"text":"あいつは正直者 "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>179"},{"br":1},{"size":18,"bold":true,"text":"あいつ日本語話せないじゃん "}],[{"size":18,"bold":true,"color":"mediumblue","text":">>180"},{"br":1},{"size":18,"bold":true,"text":"正直、総理大臣は英語話せないやつより日本語話せないやつの方がまだマシだと思う "}],[{"size":18,"bold":true,"text":" もう進次郎が対案だろ "}],[{"size":18,"bold":true,"text":" もう1回岸田さん "}],[{"size":18,"bold":true,"text":" 岩屋さんか赤沢さんを推す "}],[{"size":18,"bold":true,"text":" 知らんけど石破でよかったやろ？ "}],[{"color":"mediumblue","size":18,"bold":true,"text":">>326"},{"br":1},{"color":"#ff0000","size":18,"bold":true,"text":"よくなかったから負けたんちゃう？ "},{"br":1},{"text":"元スレ: "},{"text":"https://hayabusa.open2ch.net/test/read.cgi/livejupiter/1792544621/"}]],