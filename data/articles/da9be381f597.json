{"id":"da9be381f597","publishedAt":1795307971000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/9/c/9cd858db.jpg"}],[{"bold":true,"text":"🙌 "},{"bold":true,"href":"https://t.co/i5X5GdTczV","text":"pic.twitter.com/i5X5GdTczV"},{"br":1},{"bold":true,"text":"— ちいかわ💫アニメ火金 (@ngnchiikawa) "},{"bold":true,"href":"https://x.com/ngnchiikawa/status/2124156927181791413?ref_src=twsrc%5Etfw","text":"2026年11月21日"}],[{"color":"rgb(219, 0, 0)","size":28,"bold":true,"text":"\nドゴォッ"}],[{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\nなんだこれは…"}],[{"bold":true,"text":"\n光学兵器！！！？"}],[{"bold":true,"text":"\nパピコの件終わってないのに新たな呪物持ち込んで来るなや！"}],[{"color":"rgb(247, 70, 158)","size":23,"bold":true,"text":"\n擬音がジョジョとかそっち系なんよ"}],[{"bold":true,"text":"\nナガノおかしいだろ"}],[{"bold":true,"text":"\nモナ王の生存能力よ"}],[{"bold":true,"text":"\n全く予想してなかったから滅茶苦茶笑ってしまった"}],[{"bold":true,"text":"\n>>14"},{"br":1},{"bold":true,"text":"\nこれ予想できるやつナガノしかいねぇよ"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\n相変わらずモナ王がずっと面白い"}],[{"bold":true,"text":"\nハチワレ怒らせるアイテム"}],[{"bold":true,"text":"\n久しぶりに笑った"}],[{"bold":true,"text":"\nどっから持ってきたんだよそのカメラじゃない物体は！"}],[{"bold":true,"text":"\n怒ワレが改造したのか？"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\n作者はモナ王殺そうとすんな"}],[{"bold":true,"text":"\n一話見逃したか？"}],[{"bold":true,"text":"\nちいかわって1枚に要素過積載気味なのにしっかりまとまっててすごい"}],[{"bold":true,"text":"\nテンポがよすぎる…"}],[{"bold":true,"text":"\nなにこれッ！！"}],[{"bold":true,"text":"\n唐突に始まるな..."}],[{"bold":true,"text":"\nこれで自分に怒って消えるのかな"}],[{"color":"rgb(240, 98, 2)","bold":true,"text":"\nファンアートかと思った"},{"br":1},{"color":"rgb(240, 98, 2)","bold":true,"text":"\n本物だった"}],[{"bold":true,"text":"\nなんかこの作品妙にギャグセンスあるよね"}],[{"bold":true,"text":"\n不意打ちにも程がある"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nちいかわ最強ランキング更新されたな"}],[{"bold":true,"text":"\n>>34"},{"br":1},{"bold":true,"text":"\nNEW ENTられY！ ハチワレのカメラ型光学兵器"}],[{"color":"rgb(52, 44, 222)","bold":true,"text":"\nしたの「改造」！？"},{"br":1},{"color":"rgb(52, 44, 222)","bold":tru