d":true,"text":" 120キロくらいあるんじゃね？ "},{"br":1},{"size":19,"bold":true,"text":" 公式では95キロとなっているけど嘘つくなと言いたい "}],[{"size":19,"bold":true,"text":" 前妻は良き妻であったな "},{"br":1},{"size":19,"bold":true,"text":" やきう賭博を一身に被ってくれたし "}],[{"size":19,"bold":true,"text":" おっさんやん "}],[{"size":19,"bold":true,"text":" マジでデブやん "}],[{"size":19,"bold":true,"text":" 一平が栄養士と相談してたの草 "},{"br":1},{"size":19,"bold":true,"text":" アイツ金ヤバいぐらい使ったけど1000億稼ぐだけの体型貯金作ったのもアイツやろ "}],[{"size":19,"bold":true,"text":" やっぱ大谷に人生かけてた一平が必死で管理してたんかね "}],[{"size":19,"bold":true,"text":" そこらの一般人でも三十でここまで肥えてる奴はなかなか見んけど "}],[{"size":19,"bold":true,"text":" 太りすぎで草 "}],[{"size":19,"bold":true,"text":" なんでなんやろな "},{"br":1},{"size":19,"bold":true,"text":" 走り込みが足りないんか？大谷ともあろうもんが？ "}],[{"size":19,"bold":true,"text":" 二刀流の末路 "}],[{"size":19,"bold":true,"text":" 大谷が自炊して作った食事をスマホで撮って栄養士に送り「炭水化物が足りない」と言われた時に不足分を塩パスタで補ってたってだけの話なんだけどな "},{"br":1},{"size":19,"bold":true,"text":" 米はすぐ炊けないしパンだと炭水化物以外が入ってるから乾燥パスタを茹でて塩かけてただけ "},{"br":1},{"size":19,"bold":true,"text":" それが面白おかしく伝わってるけど "}],[{"size":19,"bold":true,"text":" 手足細くて腹だけ出てて草 "}],[{"bold":true,"text":" 一旦わざと太ってこっから筋肉つけるやつじゃないの？ "}],[{"size":19,"bold":true,"text":" 滑舌悪そう "}],[{"bold":true,"color":"mediumblue","text":">>151"},{"br":1},{"bold":true,"text":" そんなに似てましゅかね？ "},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/plusmicro26/imgs/0/6/062e8241.jpg"}],[{"size":19,"bold":true,"text":" 大谷のとこにすぐ行けるように一緒に高級住宅街に住んでたらそら金かかるわな "},{"br":1},{"size":19,"bold":true,"text":" 十分な金は払ってた言うけどもっと多く渡すべきやったんやないか一平に "}],[{"size":19,"bold":true,"text":" 今も盗塁やれるんか？ "}],[{"size":19,"bold":true,"text":" パワーAからSに上がってそう "}],[{"bold":true,"text":" 野球マシーンだったのに家庭持った途端こんな人間臭い変化するとは分からんもんやな "}]],"comments":["は","働",">>1>>2イチコメ阻止拡散バ|カし|ね",">>1>>2悪人ハッ|カーキチ|ガイクズ",">>1>>2妨害活動迷惑"]}