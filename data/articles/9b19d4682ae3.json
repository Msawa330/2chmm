{"id":"9b19d4682ae3","publishedAt":1795297167000,"posts":[[{"size":17,"text":" ワイ「全く飲んでないです」 "}],[{"size":17,"text":" お医者さん目に見えて動揺してて草 "}],[{"size":17,"text":" 病気なんか "}],[{"size":17,"text":" ちょっと待ってな"},{"br":1},{"size":17,"text":"はるわ "}],[{"size":17,"text":"このALTってのがとくにあれで"},{"br":1},{"size":17,"text":"普通は30以下だって "},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/funs/imgs/3/b/3b92076e.jpg"}],[{"size":15,"color":"rgb(0, 102, 212)","text":">>9"},{"br":1},{"size":17,"text":"これたまに一時的に急上昇する時があるらしいが四項目はやばそう "}],[{"size":15,"color":"rgb(0, 102, 212)","text":">>9"},{"br":1},{"size":17,"text":"酒やってなくて肝機能悪いなら完全にデブやろ "}],[{"size":15,"color":"rgb(0, 102, 212)","text":">>9"},{"br":1},{"size":17,"text":"戦闘力が高すぎる "}],[{"size":17,"text":" 肝臓のダメージ具合みたいなもんみたい "}],[{"size":17,"text":" 酒飲んでなくてこれはヤバいだろ "}],[{"size":17,"text":"恵体やろ "},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/funs/imgs/9/7/9766e14a.jpg"}],[{"size":17,"text":" なんだデブか "}],[{"size":17,"text":" 嘘ついとるわけやなく本当に飲んでないんか "}],[{"size":15,"color":"rgb(0, 102, 212)","text":">>23"},{"br":1},{"size":17,"text":"年に3回くらいのレベルや "}],[{"size":17,"text":" ワイのスペックに一番近いポケモンチャッピーに聞いたら"},{"br":1},{"size":17,"text":"メガメガニウムやった "}],[{"size":17,"text":" 脂肪肝ガンギマリってとこか "}],[{"size":17,"text":" やっぱり肥満って体に悪いんやな "}],[{"size":17,"text":" γGTの方がやばくね？ "}],[{"size":17,"text":" 食生活を見直せばまだいける "}],[{"size":17,"text":" お医者さん他になんか言うてなかったか？ "}],[{"size":15,"color":"rgb(0, 102, 212)","text":">>38"},{"br":1},{"size":17,"text":"お決まりの"},{"br":1},{"size":17,"text":"味濃いのやめー"},{"br":1},{"size":17,"text":"甘いのみものやめー"},{"br":1},{"size":17,"text":"適度な運動をー "}],[{"size":15,"color":"rgb(0, 102, 212)","text":">>47"},{"br":1},{"size":17,"text":"お決まりの～って舐めてるけど"},{"br":1},{"size":17,"text":"わりとこのままだと死ぬか人工透析か足切り落としとかなるで "}],[{"size":15,"color":"rgb(0, 102, 212)","text":">>129"},{"br":1},{"size":17,"text":"舐めてないだろ"},{"br":1},{"size":17,"text":"ほな処方箋で軽い運動を出してくれ "}],[{"size":17,"text":"飯はこんな感じで一食2～3合は米くえるな "},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/funs/imgs/7/f/7fc44504.