{"id":"abce0b4c873f","publishedAt":1794134038000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/7/9/79dc02e5.png"}],[{"color":"rgb(52, 44, 222)","bold":true,"text":"\nなにコレっ！！？"},{"br":1},{"color":"rgb(52, 44, 222)","bold":true,"text":"🍦 "},{"color":"rgb(52, 44, 222)","bold":true,"href":"https://t.co/ZEcTIOwehS","text":"pic.twitter.com/ZEcTIOwehS"},{"br":1},{"color":"rgb(52, 44, 222)","bold":true,"text":"— ちいかわ💫アニメ火金 (@ngnchiikawa) "},{"color":"rgb(52, 44, 222)","bold":true,"href":"https://x.com/ngnchiikawa/status/2119068998621106674?ref_src=twsrc%5Etfw","text":"2026年11月7日"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\nちいかわドン引きシリーズ好き"}],[{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\nじゃんけんすな"}],[{"bold":true,"text":"\nちゃっかり哀ワレが食べ始めてる"}],[{"bold":true,"text":"\n>>7"},{"br":1},{"bold":true,"text":"\n顔に似合わずやり手だぞこいつ"}],[{"bold":true,"text":"\nハチワレのおかしさにちいかわが狼狽えるノリ好き"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nちいかわがドン引きしてる回にハズレなし"}],[{"bold":true,"text":"\nパピコ溶けるから…！言い出したときのちいかわの反応がずるい"}],[{"bold":true,"text":"\n同時に謎の新商品を出されたグリコが何を思ってるかも気になる"}],[{"bold":true,"text":"\n>>17"},{"br":1},{"bold":true,"text":"\nパピコ公式アカウントは嬉しそうだった　良かった"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\n商品化希望…"}],[{"bold":true,"text":"\n>>18"},{"br":1},{"bold":true,"text":"\n食べたいもんなロングストロングパピコ"}],[{"bold":true,"text":"\n>>32"},{"br":1},{"bold":true,"text":"\n値段変わらないしな"}],[{"bold":true,"text":"\nずっとパピコ吸ってる哀ワレ"}],[{"color":"rgb(240, 98, 2)","bold":true,"text":"\n自分もじゃんけんの対象に入れるのいいやつすぎるだろハチワレ"}],[{"bold":true,"text":"\n分裂の話はパピコ食べてからでもできる"},{"br":1},{"bold":true,"text":"\nでもパピコは食べないと溶ける"}],[{"bold":true,"text":"\n既にあげた哀ワレから取り上げず"},{"br":1},{"bold":true,"text":"\n残った喜怒楽ワレと平等にジャンケンで決めようとするのノンキすぎる"}],[{"bold":true,"text":"\nハチワレの確定分無くして自分もじゃんけんしてるの優しい子だな"}],[{"bold":true,"text":"\n>>52"},{"br":1},{"bold":true,"text":"\nそういうところは良い子なんだけど危機感がなさすぎる…"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nなんで本体のハチワレがじゃんけん合戦してるのに哀ワレちゃっかりパピコ食ってんだよ"}],