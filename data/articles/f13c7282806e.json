":1},{"color":"#111111","size":18,"bold":true,"text":"日本は大理石が無いのと民族的に2D方面への関心が強かったんだと思うわ"}],[{"color":"#111111","size":18,"bold":true,"text":"一周回って埴輪なんじゃないの"}],[{"color":"#15803d","size":18,"bold":true,"text":"かわいいじゃねえか"}],[{"color":"#111111","size":18,"bold":true,"text":"慢心、環境の違い…"}],[{"color":"#111111","size":18,"bold":true,"text":"日本人は可愛い～が好きなんだよ"}],[{"color":"#111111","size":18,"bold":true,"text":"昔からアニメの国だったのか"}],[{"color":"#111111","size":18,"bold":true,"text":"でもヨーロッパ人もローマ帝国が滅亡して1000年くらいの間はこういうもんが作れなくなった"}],[{"color":"#111111","size":18,"bold":true,"text":"そもそも埴輪は古墳の埋葬品であって、芸術品じゃないしな"}],[{"color":"#b45309","size":18,"bold":true,"text":"ピカソは16世紀でもハニワ以下やぞ"},{"br":1},{"color":"#b45309","size":18,"bold":true,"text":"論破"}],[{"color":"#1f32ff","size":18,"bold":true,"text":">>16"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"ピカソは写実画家だぞ"}],[{"color":"#111111","size":18,"bold":true,"text":"ローマつーかギリシャ文化だろが"}],[{"color":"#111111","size":18,"bold":true,"text":"火炎式土器、遮光器土偶を経由して埴輪なんだぞ"}],[{"color":"#7c3aed","size":18,"bold":true,"text":"日本はすでに量産に着手していた"},{"br":1},{"color":"#7c3aed","size":18,"bold":true,"text":"芸術家がコツコツ何年もかけて彫るとか流行んねんだよ"}],[{"color":"#111111","size":18,"bold":true,"text":"埴輪は、ワザと抽象的に造形されたものだとかいう説があるらしい"}],[{"color":"#1f32ff","size":18,"bold":true,"text":">>30"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"浮世絵やら現代のマンガやら昔から日本人はデフォルメされたもんが好きなんやろな"}],[{"color":"#7c4a28","size":18,"bold":true,"text":"大昔からこの国は可愛いが正義の国だぞ"},{"br":1},{"color":"#7c4a28","size":18,"bold":true,"text":"実写的なものは求められてない"}],[{"color":"#111111","size":18,"bold":true,"text":"日本には天平文化の仏像とか凄いのいっぱい残ってるけど"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"同時代のヨーロッパにそういう芸術品はほとんどないからね"}],[{"color":"#111111","size":18,"bold":true,"text":"見たまんま作るよりデフォルメして作る方がより知的レベル高くないか"}],[{"color":"#111111","size":18,"bold":true,"text":"日本人はあまり写実的なものを好まないからな"}],[{"color":"#15803d","size":18,"bold":true,"text":"大地震巨大津波破局噴火をかいくぐっての出土品なんで許して"}],[{"color":"#111111","size":18,"bold":true,"text":"別に文化的に遅れてたってだけでいいじゃない"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"その上で埴輪は埴輪でいいものなのよ"}],[{"color":"#111111","size":18,"bold":true,"text":"群馬の博物館見に行ってみようよ。"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"見事な埴輪なんかがゾロゾロ並んでるぞ。"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"国宝だったりするからな。"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"俺はまずその造形ってのもそうだが思ったよりも大きくてびっくりしたわ。"}],[{"color":"#111111","size":18,"bold":true,"text":"日本はあんまり写実に興味なかったんすよねいまもそうだけど"}],[{"color":"#111111","size":18,"bold":true,"text":"こういうのはローマ人だからとか日本人だからっていう話じゃないし時代でもないだろ"},{"br":1},{"color":"#111111","size":18,"bold":true,"text":"今お前埴輪作れるのか？"}],[{"color":"#111111","size":18,"bold":true,"text":"飛鳥時代以降の仏像なら今も現役ですけど"}],[{"color":"#b45309","size":18,"bold":true,"text":"はに丸の恐さは異常"}],[{"color":"#111111","size":18,"bold":true,"text":"かわいいから"}],[{"color":"#111111","size":18,"bold":true,"text":"ところでアウグストゥスに取り憑いてる子供はなんなのさ"}],[{"color":"#d62828","size":18,"bold":true,"text":"日本は2026年になってもまだちいかわ作っとるからね"},{"br":1},{"color":"#d62828","size":18,"bold":true,"text":"1万年先もこの路線だよ"}]],"comments":["プリン生き埋め",">>1\n縄文土器知らんの？","𓆲𓆲埴輪と土偶です\n𓆈書ですが\n黒色人種の日本の難易度の攻略しているものと相性は関係ありますね",">>2メラニン色素の濃い順番で、\n医療と、芸術と、相性、",">>4感性文化土俵相性有利不利"]}