{"id":"a396bc96c234","publishedAt":1794886328000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/diet2channel/imgs/1/6/165bfc5f.png"}],[{"color":"#0000cd","size":16,"bold":true,"text":" ワイ「休息日メニューや、普段あんま追い込んでないとこやろ」"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":"もう病気やんこんなん"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":"頭おかC"}],[{"size":16,"bold":true,"text":" ワイ「今日こそ筋トレするんや」→寝る "}],[{"size":16,"bold":true,"text":" 夢中になれるのはいいことや "}],[{"size":16,"bold":true,"text":" 休息日は肩周りだけやって帰るわ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" ワイシャツ破けすぎてイライラするンゴォオオオ！！！"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":"前に教えてもらったジャージ素材のワイシャツまだこないンゴォオオオ！！！！ "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>8"},{"br":1},{"size":16,"bold":true,"text":"草 "}],[{"size":16,"bold":true,"text":" ブロリーニキやん "}],[{"color":"#0000cd","size":16,"bold":true,"text":" あと筋トレはじめたころに買ってずっと大切に使ってたダンベル(セメント)が壊れたンゴ"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":"部屋中セメント粉まみれになって二度と筋トレするものかと想いながら新しいダンベル注文してからショルダープレス続けたンゴ "}],[{"size":16,"bold":true,"text":" 鉄製のが小さくてええやろ "}],[{"color":"mediumblue","size":16,"bold":true,"text":">>12"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":"鉄製のもあるんやけどな"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":"重いプレートはまあまあ高いから一部セメント製のも使てたんや"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":"そしたら空中で爆ぜた "}],[{"size":16,"bold":true,"text":" 空中で爆ぜたとか怖すぎて草 "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 粉々になったセメントの粉末がボワワーーー！！！って部屋中に飛んでったで "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>17"},{"br":1},{"size":16,"bold":true,"text":"身体みせろ！ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" ワイシャツが尽きたので仕事休みます "}],[{"size":16,"bold":true,"text":" なんかオーバーワークやと逆に筋肉減るらしいやん "}],[{"size":16,"bold":true,"text":" ワイ「今日こそ筋トレするんや」→おんjする "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 仕方なく仕事でてきたけどスーツきつくて仕事したくないンゴ"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":"だからNintendo Switch持ってきました "}],[{"size":16,"bold":true,"text":" 給料泥棒は草 "}],[{"color":"#0000cd","size":16,"bold":true,"text":" お前ら仕事中のプロテインどうしてる？、 "}],[{"size":16,"bold":true,"text":" 仕事中にプロテイン飲むなよ "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 飲めないなら会社やめます "}],[{"size":16,"bold":true,"color":"mediumblue","text":">>31"},{"br":1},{"size":16,"bold":true,"text":"うーんこの "}],[{"color":"#0000cd","size":16,"bold":true,"text":" ちゃんと2～4時間置きに飲まんといかんやろ"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":"感覚はタンパク質量次第な "}],[{"size":16,"bold":true,"text":" イッチビルダーになれそう "}],[{"color":"#0000cd","size":16,"bold":true,"text":" ものすごい金持ちになれるならやるけど難しそうやなビルダー"},{"br":1},{"color":"#0000cd","size":16,"bold":true,"text":"このまま客を筋肉で煽るサラリーマンやるしかないンゴねぇ "}],[{"size":16,"bold":true,"text":" 背中みせて…みせてクレメンス "}],[{"color":"#0000cd","size":16,"bold":true,"text":" 背中撮れるだけの鏡とかないから無理や "}],[{"color":"#ff3366","size":24,"bold":true,"text":" プロテイン飲みにきてるのか仕事しにきてるのか "},{"br":1},{"bold":true,"color":"rgb(255, 51, 102)","text":"▼アクセスの多い関連記事"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/61582838.html","color":"rgb(0, 102, 204)","text":"ワイ「今日は休息日にするンゴ」←結局筋トレする奴ｗｗｗｗ"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/60967572.html","color":"rgb(0, 102, 204)","text":"ワイ「今日こそ休息日にするンゴ」←結局筋トレしちゃう奴ｗｗｗｗｗ"},{"br":1},{"bold":true,"text":"・"},{"bold":true,"href":"http://blog.livedoor.jp/diet2channel/archives/60321510.html","color":"rgb(0, 102, 204)","text":"【質問】家で作業する時お菓子やコーヒー飲む？"},{"br":1},{"color":"gray","text":"引用元:"},{"color":"gray","text":"http://hayabusa.open2ch.net/test/read.cgi/livejupiter/1578966385/"},{"br":1},{"text":"<url>"},{"text":"<title>"}]],"comments":[]}