{"id":"facfffe2a4f8","publishedAt":1795496261000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/1/9/194904fc.jpg"}],[{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"\nシュシュ～！！"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"【名探偵プリキュア！×ビアードパパ】"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"昨年人気だった“プリキュアシュー”再び✨️"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"📅12月1日（火）～数量限定で登場🤍"},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"href":"https://t.co/uuChNjwlN3","text":"https://t.co/uuChNjwlN3"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"▫️甘酸っぱいいちごチョコでコーティング"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"▫️ハートと星を散りばめてキュートに"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"▫️描き下ろしイラストの限定グッズ付き "},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"href":"https://t.co/5QuFlzluZe","text":"pic.twitter.com/5QuFlzluZe"},{"br":1},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"— モデルプレス (@modelpress) "},{"color":"rgb(52, 44, 222)","size":23,"bold":true,"href":"https://x.com/modelpress/status/2125065054295060883?ref_src=twsrc%5Etfw","text":"2026年11月24日"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\n今年もやるんだ"}],[{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\n🍨 シューアイスじゃないからやり直し"}],[{"bold":true,"text":"\n>>4"},{"br":1},{"bold":true,"text":"\nとか言いながら両手で持ちやがって"}],[{"bold":true,"text":"\n真っ当に喜んでるシュシュタン久しぶりに見た"}],[{"bold":true,"text":"\nだがしかしシュシュタンは居ない…"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\n>>5"},{"br":1},{"color":"rgb(247, 70, 158)","bold":true,"text":"\nシュシュタンは練り込まれているのかも"}],[{"bold":true,"text":"\n>>9"},{"br":1},{"bold":true,"text":"\n洗濯機の次はミキサーでシュか"}],[{"bold":true,"text":"\n>>12"},{"br":1},{"bold":true,"text":"\n回転･撹拌する器械と相性が良いのかな"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\n森亜だけ2個買ってない？"}],[{"bold":true,"text":"\nアルカナの長く？と思ったらこれ2個持ちか"},{"br":1},{"bold":true,"text":"\n食べる専発揮すな"}],[{"bold":true,"text":"\nシュークリームが好きなんだっけシュシュタン"}],[{"bold":true,"text":"\nプリキュアをゴールにシュー！！！！"}],[{"bold":true,"text":"\n>🍥 なるとシューじゃないからはなまるやり直し"}],[{"bold":true,"text":"\n>>🍥 なるとシューじゃないからはなまるやり直し"},{"br":1},{"bold":true,"text":"\n🦊あなたのセンスはカス！"}],[{"color":"rgb(181, 12, 205)","size":23,"bold":true,"text":"\nこれはアルカナの分！"},{"br":1},{"color":"rgb(181, 12, 205)","size":23,"bold":true,"text":"\nこれはアルカナシャドウの分！"}],[{"bold":true,"text":"\n>>18"},{"br":1},{"bold":true,"text":"\n🌸（そうだ…どちらもお前さんだ…だから2回並んでも問題ないってわけだ…）"}],[{"bold":true,"text":"\n4個買ったらコンプリートできるの？"}],[{"bold":true,"text":"\n4人ともパパは居ないのに"}],[{"bold":true,"text":"\n>>23"},{"br":1},{"bold":true,"text":"\n明智はまだ不確定だろ！？"}],[{"bold":true,"text":"\n>>23"},{"br":1},{"bold":true,"text":"\nbeardのスラングを調べるんだ"}],[{"color":"rgb(52, 44, 222)","bold":true,"text":"\n>>29"},{"br":1},{"color":"rgb(52, 44, 222)","bold":true,"text":"\n英語のスラングで beard（ビアード） は、主に「同性愛者であることを周囲に隠すための、偽装の恋人・配偶者（隠れ蓑）」という意味で使われます。"},{"br":1},{"color":"rgb(52, 44, 222)","bold":true,"text":"\n知りたくなかったそんなこと…"}],[{"bold":true,"text":"\n>>62"},{"br":1},{"bold":true,"text":"\n森亜お前…"}],[{"bold":true,"text":"\n>>68"},{"br":1},{"bold":true,"text":"\n森亜はくれあさんが好きなだけで同性愛者じゃないから…"}],[{"bold":true,"text":"\n偏在するシュシュタン"}],[{"bold":true,"text":"\nくれあのシュークリームたべたい"}],[{"bold":true,"text":"\n去年と一緒か"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nしげちーみたい"}],[{"bold":true,"text":"\nミスティック要素しかないでシュ"}],[{"bold":true,"text":"\nいちごチョコがかかってるから実質エクレア"}],[{"color":"rgb(219, 0, 0)","bold":true,"text":"\nもしかしてアイス関係なくたんプリで1番食うやつなのかアルカナ"}],[{"bold":true,"text":"\n>>32"},{"br":1},{"bold":true,"text":"\nハロウィンのお菓子は格別言ってたし結構食い意地は張ってる子"}],[{"bold":true,"text":"\n>>32"},{"br":1},{"bold":true,"text":"\nたんプリで1番食事シーンが多いのコイツだぞ"},{"br":1},{"bold":true,"text":"\nメインキャラで1番少ないのはくれあさんだ"}],[{"bold":true,"text":"\n>>32"},{"br":1},{"bold":true,"text":"\nおかげさまでるるかのチキン。とかチェリー乗せまくりとか不名誉な称号を得てしまった"}],[{"bold":true,"text":"\nこれでシュシュタンが居ないの詐欺でしょ…"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\n31ともコラボして"},{"br":1},{"color":"rgb(181, 12, 205)","bold":true,"text":"\nやくめでしょ"}],[{"bold":true,"text":"\n>>37"},{"br":1},{"bold":true,"text":"\nコラボで渋滞しまくってるのが悪い"},{"br":1},{"bold":true,"text":"\nしかも森亜専用みたいなもんだろ"}],[{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\nビアードパパ1号店は1999年誕生なので実"}]],"comments":["ｼｭｰ…",">>1\n1か…2くらいですかね","ビアードパパとしては去年のキミプリで味を占めたのか？"]}