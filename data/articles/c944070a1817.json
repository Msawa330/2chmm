{"id":"c944070a1817","publishedAt":1793445826000,"posts":[[{"color":"#3366cc","size":18,"bold":true,"text":" これがザクロです。"},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/karukan123/imgs/f/f/ff2683b3.jpg"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"【神季節】「秋」のアンチ、一人も存在しない"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"・"},{"color":"#666666","size":18,"bold":true,"href":"https://karukantimes.com/archives/51902390.html","text":"https://karukantimes.com/archives/51902390.html"}],[{"color":"#3366cc","size":18,"bold":true,"text":" あんま見たことなかったから思わず買ってしもた "}],[{"color":"#666666","size":18,"bold":true,"text":" わかる "}],[{"color":"#3366cc","size":18,"bold":true,"text":" 500円くらい "}],[{"img":"https://livedoor.sp.blogimg.jp/karukan123/imgs/f/6/f657e91e.jpg"},{"br":1},{"color":"#6699cc","size":18,"bold":true,"text":"今年初収穫したワイにタイムリーなスレ "}],[{"color":"#666666","size":18,"bold":true,"text":" 割って "}],[{"color":"#666666","size":18,"bold":true,"text":" 来たねぇけど中がいい感じなんだろな "}],[{"color":"#3366cc","size":18,"bold":true,"text":" 割って行きます"},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/karukan123/imgs/7/5/7591bf38.jpg"}],[{"color":"#3366cc","size":18,"bold":true,"text":" 皮は結構やわかい "}],[{"color":"#666666","size":18,"bold":true,"text":" 少なくね？割れ方の問題？ "}],[{"color":"#666666","size":18,"bold":true,"text":" 畳がなんかいい感じやね "}],[{"color":"#3366cc","size":18,"bold":true,"text":" こんなもんなん？中って？"},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/karukan123/imgs/3/9/39c1be61.jpg"}],[{"color":"#3366cc","size":18,"bold":true,"text":" 一粒食べてみたけど想像通りの味っていうか。種は食べていいらしいけど美味しくない "}],[{"img":"https://livedoor.sp.blogimg.jp/karukan123/imgs/2/d/2dc336b9.jpg"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"4等分を目指していきます "}],[{"color":"#3366cc","size":18,"bold":true,"text":" 量少なくない？もっとブワッてなってるもんやと思ってたけど "}],[{"color":"#6699cc","size":18,"bold":true,"text":" 可食部はこんなもんやで"},{"br":1},{"color":"#6699cc","size":18,"bold":true,"text":"ボールに水張って中でバラしてザルにあげる "}],[{"color":"#3366cc","size":18,"bold":true,"text":" 結構キレイやな"},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/karukan123/imgs/6/5/651a7c02.jpg"}],[{"color":"#666666","size":18,"bold":true,"text":" >>19"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"美味そう "}],[{"img":"https://livedoor.sp.blogimg.jp/karukan123/imgs/8/f/8fa1cd8f.jpg"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"まるで宝石箱やー "}],[{"color":"#666666","size":18,"bold":true,"text":" ザクロジュースの味？ "}],[{"color":"#3366cc","size":18,"bold":true,"text":" >>21"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"果肉はそんな感じの味 "}],[{"color":"#666666","size":18,"bold":true,"text":" 口の中でぐじゅぐじゅして種は吐き出すんやろ "}],[{"color":"#3366cc","size":18,"bold":true,"text":" >>23"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"種は食べれて栄養価も多いって聞いたんやが "}],[{"color":"#666666","size":18,"bold":true,"text":" なつかし "}],[{"color":"#339999","size":18,"bold":true,"text":" 中学の体育館の横に生えてたな"},{"br":1},{"color":"#339999","size":18,"bold":true,"text":"素行悪い同級生とかは普通に授業中抜け出して食べてた "}],[{"color":"#666666","size":18,"bold":true,"text":" ザクロ石って鉱石があるほどザクロは綺麗なんや "}],[{"color":"#3366cc","size":18,"bold":true,"text":" ボールに水張って果肉取り出してるから待っててね "}],[{"color":"#666666","size":18,"bold":true,"text":" 美味い？ "}],[{"color":"#3366cc","size":18,"bold":true,"text":" >>31"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"果肉はうまい。種はまずい "}],[{"color":"#3366cc","size":18,"bold":true,"text":" ポップコーンの奥底の食感。ガムみたく果肉だけ噛んで種を吐き出したくなる "}],[{"color":"#6699cc","size":18,"bold":true,"text":" 果汁を搾る機械で搾ってドレッシングとかシロップ、ジュースにするとええで "}],[{"color":"#3366cc","size":18,"bold":true,"text":" 果肉がとれましたわ"},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/karukan123/imgs/a/7/a7884974.jpg"}],[{"color":"#3366cc","size":18,"bold":true,"text":" 皮の割合が高すぎる"},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/karukan123/imgs/9/c/9c6edd4c.jpg"}],[{"color":"#666666","size":18,"bold":true,"text":" >>38"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"あずきにしか見えん "}],[{"color":"#3366cc","size":18,"bold":true,"text":" 果肉自体が割合低いし、その果肉も大部分が種 "}],[{"color":"#666666","size":18,"bold":true,"text":" 品種で中の粒の量だいぶちがうよ "}],[{"color":"#3366cc","size":18,"bold":true,"text":" 思ってたんと違う。もっとジューシーなかんじ想像してたのに "}],[{"color":"#666666","size":18,"bold":true,"text":" ザクロジュースにすればいいのに… "}],[{"color":"#3366cc","size":18,"bold":true,"text":" >>44"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"ジュースならその辺で買えるやろ。フルーツとして食べたいの "}],[{"color":"#666666","size":18,"bold":true,"text":" >>45"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"生搾りのフレッシュジュースはいいぞ～ "}],[{"color":"#3366cc","size":18,"bold":true,"text":" この種のかんじパッションフルーツを思い出す "}],[{"color":"#666666","size":18,"bold":true,"text":" ザクロって品種改良して種無し作れたら天下取れると思うんだよなぁ"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"イッチ研究してみてよ "}],[{"color":"#3366cc","size":18,"bold":true,"text":" >>50"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"やれるならやりたいわ "}],[{"color":"#3366cc","size":18,"bold":true,"text":" シャインマスカットのザクロ版みたいなのあったらいいのに "}],[{"color":"#3366cc","size":18,"bold":true,"text":" これジュースにしたいけど、絶対に量が足りんやろ"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"コップ1杯も作れんやろ "}],[{"color":"#6699cc","size":18,"bold":true,"text":" せやな"},{"br":1},{"color":"#6699cc","size":18,"bold":true,"text":"たくさん買うか自前で育てるしかないけど、柘榴は高温は良いけど多湿の日本には不向き "},{"br":1},{"text":"https://hayabusa.open2ch.net/test/read.cgi/livejupiter/1791793050/"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":" 【おすすめ記事】"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"・"},{"color":"#666666","size":18,"bold":true,"href":"https://karukantimes.com/archives/51917320.html","text":"本気で鍋と向き合った時"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"・"},{"color":"#666666","size":18,"bold":true,"href":"https://karukantimes.com/archives/51888756.html","text":"美味しい郷土料理教えて"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"・"},{"color":"#666666","size":18,"bold":true,"href":"https://karukantimes.com/archives/51916968.html","