{"id":"61fe3da90c8f","publishedAt":1793359433000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/karukan123/imgs/7/a/7a51233e.jpg"}],[{"color":"#3366cc","size":18,"bold":true,"text":" 単純な良い香りだけじゃないんよな "},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"秋だしツーリングしてくる"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"・"},{"color":"#666666","size":18,"bold":true,"href":"https://karukantimes.com/archives/51740451.html","text":"https://karukantimes.com/archives/51740451.html"}],[{"color":"#ff6699","size":18,"bold":true,"text":" 秋を感じるんよ "}],[{"color":"#3366cc","size":18,"bold":true,"text":" >>6"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"秋の寂しい感じともマッチする "}],[{"color":"#666666","size":18,"bold":true,"text":" >>13"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"秋の夕暮れって無性に寂しくなるよな "}],[{"color":"#339999","size":18,"bold":true,"text":" 半袖を撫でる少し冷たい風が吹くと、金木犀の匂いが後を追うようにワイの鼻腔をくすぐる。 "}],[{"color":"#666666","size":18,"bold":true,"text":" 寂しいのに不快じゃない "}],[{"color":"#666666","size":18,"bold":true,"text":" 実が美味しいから良い匂いがするとかならわかるんやけどな"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"実もならないし葉や花を食べるわけでもないのに良い匂いに感じるのってなんなんやろな "}],[{"color":"#3366cc","size":18,"bold":true,"text":" >>9"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"たしかに美味しそうな匂いではない"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"食べようとは思わんわ "}],[{"color":"#666666","size":18,"bold":true,"text":" 桂花陳酒すき"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"金木犀を白ワインに漬け込んだお酒 "}],[{"color":"#666666","size":18,"bold":true,"text":" >>14"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"上品だね "}],[{"color":"#3366cc","size":18,"bold":true,"text":" ワイの実家の庭に梅の木が植えてあって毎年春になると花咲かてた"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"でも梅の花の匂いには対してノスタルジックな気持ちにならんのや "}],[{"color":"#3366cc","size":18,"bold":true,"text":" 夕暮れと金木犀のコンボはやばい"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"視覚と嗅覚で胸いっぱいになる "}],[{"color":"#666666","size":18,"bold":true,"text":" >>22"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"まず年が終わると言う感覚が寂しいと思うのは充実してる証拠 "}],[{"color":"#6699cc","size":18,"bold":true,"text":" そもそも「嗅覚」が一番記憶を惹起すると言われてるから"},{"br":1},{"color":"#6699cc","size":18,"bold":true,"text":"イッチはなにか幼少期に金木犀の匂いが印象的な出来事があったんだろう "}],[{"color":"#3366cc","size":18,"bold":true,"text":" >>21"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"とくに思い当たらんけど…忘れてるだけかもしれんな"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"お前らは懐かしいとか感じないんか？ "}],[{"color":"#6699cc","size":18,"bold":true,"text":" >>21"},{"br":1},{"color":"#6699cc","size":18,"bold":true,"text":"学校とか通学路とか公園とか記憶に残りやすい場面に植えられてる事が多いからやろなあ "}],[{"color":"#3366cc","size":18,"bold":true,"text":" >>27"},{"br":1},{"color":"#3366cc","size":18,"bold":true,"text":"多分そのときは気にも止めてなかったことが懐かしさに変わるんやな "},{"br":1},{"text":"https://hayabusa.open2ch.net/test/read.cgi/livejupiter/1792477011/"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":" 【おすすめ記事】"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"・"},{"color":"#666666","size":18,"bold":true,"href":"https://karukantimes.com/archives/51900843.html","text":"ワイが撮った綺麗な花の写真を貼るから"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"・"},{"color":"#666666","size":18,"bold":true,"href":"https://karukantimes.com/archives/51899797.html","text":"【朗報】秋、最高に気持ちいい"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"・"},{"color":"#666666","size":18,"bold":true,"href":"https://karukantimes.com/archives/51915577.html","text":"【悲報】秋の味覚界最強、決まらない"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"・"},{"color":"#666666","size":18,"bold":true,"href":"https://karukantimes.com/archives/51916968.html","text":"最近すげぇ柿にハマってる"},{"br":1},{"color":"#666666","size":18,"bold":true,"text":"・"},{"color":"#666666","size":18,"bold":true,"href":"https://karukantimes.com/archives/51758945.html","text":"正々堂々と秘境駅に行ってきたから写真うｐする【2019秋・会津編】"}]],"comments":["精子の匂いのする花ってなんだっけ",">>1\n栗は精子\n金木犀はトイレの芳香剤","