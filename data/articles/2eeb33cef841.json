{"id":"2eeb33cef841","publishedAt":1794919800000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/a/9/a9f4502b.jpg"}],[{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"\nこのメイド…"},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/b/7/b74e7e31.jpg"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\n煩悩！？"}],[{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\nいちゃつくな"}],[{"bold":true,"text":"\n>このプロデューサー…"}],[{"bold":true,"text":"\n煩悩になる感情があるんだ…"}],[{"bold":true,"text":"\n直球の褒めに弱いのか…チョロ…"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\nもうほぼ完堕ちしたらしいな"}],[{"bold":true,"text":"\nムッツリか…"}],[{"bold":true,"text":"\nプレイアブルになってあの態度のままはユーザーにハイレベル求めすぎだよ"}],[{"bold":true,"text":"\n>>9"},{"br":1},{"bold":true,"text":"\nまぁそうだけどデレるのが後半とかなら嬉しくね"},{"br":1},{"bold":true,"text":"\nまだ知らんのだけども"}],[{"bold":true,"text":"\n平成の追加人気ヒロインか？"}],[{"bold":true,"text":"\n可愛すぎる"}],[{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/d/8/d8d1f26a.jpg"},{"br":1},{"color":"rgb(52, 44, 222)","bold":true,"text":"\n見ろよこの毅然とした姿を"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\n>>12"},{"br":1},{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\nくぅ～これこれ！"}],[{"bold":true,"text":"\n可愛いって言われて刺激される煩悩ってなんスか"}],[{"bold":true,"text":"\n初星学園がもう煩悩を刺激してるのかもしれない"}],[{"bold":true,"text":"\nちょろすぎるだろ"}],[{"bold":true,"text":"\nアイドルへの個人的な憧れを煩悩としてるだけだからまだ堕ちてない"}],[{"bold":true,"text":"\n>>17"},{"br":1},{"bold":true,"text":"\nほなセーフか…"}],[{"bold":true,"text":"\nプロデューサーに奉仕してなぜか満足してるけど理由がわかってないからセーフだよ"}],[{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/3/8/389559c6.jpg"},{"br":1},{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/9/1/91c22dde.jpg"}],[{"bold":true,"text":"\n>>20"},{"br":1},{"bold":true,"text":"\n距離が近すぎる"}],[{"bold":true,"text":"\n>>20"},{"br":1},{"bold":true,"text":"\nあなたなんて認めませんみたいな感じかと思ったらあまあまメイドさんすぎる…"}],[{"color":"rgb(247, 70, 158)","size":23,"bold":true,"text":"\n私がほのかに感じる胸の奥の謎の疼きとかやる間もなく即堕ちしやがったですわ～！"}],[{"bold":true,"text":"\n千奈ちゃんが光の無い目で後ろから見てるぞ"}],[{"bold":true,"text":"\nデレデレですわこのメイド～！"}],[{"bold":true,"text":"\n一応ある程度仲良くなっただろう後半しかでないおでかけではあるぞ！"}],[{"color":"rgb(148, 21, 76)","bold":true,"text":"\n公式から脳破壊される千奈お嬢様の明日はどっちだ"}],[{"bold":true,"text":"\n獣のような交BIが見たいですわ～！"}],[{"bold":true,"text":"\n予想通り過ぎてもはや笑えますわ～！"},{"br":1},{"bold":true,"text":"\nこの泥棒猫"}],[{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\n>>29"},{"br":1},{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\nこの泥棒猫を連れてきたおバカさんは誰ですの！？"}],[{"bold":true,"text":"\n他の女からオススメされた弁当広げていますわ"}],[{"bold":true,"text":"\nファンディスクでヒロインになるタイプのキャラ"}],[{"bold":true,"text":"\n>>31"},{"br":1},{"bold":true,"text":"\n大体ライダーさん"}],[{"bold":true,"text":"\nクール系メイドって本当に最高だと思う"}],[{"bold":true,"text":"\n>>32"},{"br":1},{"bold":true,"text":"\nクールかな…"}],[{"color":"rgb(52, 44, 222)","bold":true,"text":"\nそこそこ信頼得られた程度でそんな極端にデレたわけではない"},{"br":1},{"color":"rgb(52, 44, 222)","bold":true,"text":"\n…と思ってたのに親愛度10で一気にアクセル踏んできた"}],[{"bold":true,"text":"\n>>33"},{"br":1},{"bold":true,"text":"\nこっちは普通にスコーンうっま…って思ってたのに奉仕欲満たせるようになってきたとか心の許し方だいぶデカいな"}],[{"bold":true,"text":"\n>>38"},{"br":1},{"bold":true,"text":"\n忠誠心が満たされた…という感じだからたぶん千奈ちゃんに向けるのと同じ"},{"br":1},{"bold":true,"text":"\nつまりPと千奈ちゃんが将来倉本グループの筆頭になる前振り"}],[{"bold":true,"text":"\n>>54"},{"br":1},{"bold":true,"text":"\nそして愛人枠に…？"}],[{"bold":true,"text":"\n>>56"},{"br":1},{"bold":true,"text":"\n主人がメイドに手を付けるのはまま聞くからな"}],[{"bold":true,"text":"\n思ったより最初の方からデレてて俺は…これはこれでありだなと思った…"}],[{"bold":true,"text":"\n想像の3倍ぐらい雌でしたわ"}],[{"color":"rgb(247, 70, 158)","bold":true,"text":"\nもっと冷"}]],"comments":[]}