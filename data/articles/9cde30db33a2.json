{"id":"9cde30db33a2","publishedAt":1794924720000,"posts":[[{"img":"https://livedoor.sp.blogimg.jp/goldennews/imgs/0/d/0d7bee54.png"}],[{"color":"rgb(52, 44, 222)","size":23,"bold":true,"text":"\nキリトかなあやっぱ"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\nヒーローとかに憧れることはあっても自認するのはあんまりない気がする"},{"br":1},{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\n自認キリトもネタみたいなもんだし"}],[{"color":"rgb(240, 98, 2)","size":23,"bold":true,"text":"\n八幡以降これといったキャラ出てきてない気がする"}],[{"bold":true,"text":"\n男は各々やってるソシャゲの主人公キャラじゃないか"}],[{"bold":true,"text":"\n>>7"},{"br":1},{"bold":true,"text":"\nゲームによるんだろうけど自分を重ねてねとお出しされたのはそら重ねるだろ"}],[{"bold":true,"text":"\n>>7"},{"br":1},{"bold":true,"text":"\n自己投影を前提にしてるソシャゲ主人公と1人のキャラとして作ってるスレ画のキャラとは明らかに種類が違うじゃん"}],[{"bold":true,"text":"\n>>7"},{"br":1},{"bold":true,"text":"\nキャラ立ってるタイプだと自認できないな…"},{"br":1},{"bold":true,"text":"\n最近はそういうの多い"}],[{"bold":true,"text":"\n俺は⚪︎⚪︎にはなれない…とかやってるの全部"}],[{"bold":true,"text":"\n>>2"},{"br":1},{"bold":true,"text":"\nガンダムかぁ"}],[{"color":"rgb(181, 12, 205)","bold":true,"text":"\n男の場合もう素直に自己投影するのは散々冷笑されすぎたせいで"},{"br":1},{"color":"rgb(181, 12, 205)","bold":true,"text":"\n>>2"},{"br":1},{"color":"rgb(181, 12, 205)","bold":true,"text":"\n方向でスカした形の自己投影やるしか無くなってるのはある"},{"br":1},{"color":"rgb(181, 12, 205)","bold":true,"text":"\nまあだとしても主人公大好きマンになってるんだが"}],[{"bold":true,"text":"\n自称森田"}],[{"bold":true,"text":"\n自認がメスになってる男は増えてる"}],[{"bold":true,"text":"\nハルヒの杉田"}],[{"color":"rgb(219, 0, 0)","size":23,"bold":true,"text":"\n自認ライナー"}],[{"bold":true,"text":"\n>>17"},{"br":1},{"bold":true,"text":"\nおかしくなっちまったんだろ？"}],[{"bold":true,"text":"\n自認景吾"}],[{"color":"rgb(52, 44, 222)","bold":true,"text":"\nおじさんの「」ではなく中高生男子に受けてる主人公で考えるべきでは"}],[{"bold":true,"text":"\n>>25"},{"br":1},{"bold":true,"text":"\n全部ラノベになっちゃう"}],[{"bold":true,"text":"\nHACHIMANは現役コンテンツだよ"},{"br":1},{"bold":true,"text":"\n次が出てないから"}],[{"bold":true,"text":"\n近頃だと自認麦わら海賊団が反社やってたな"}],[{"color":"rgb(219, 0, 0)","bold":true,"text":"\n>>30"},{"br":1},{"color":"rg